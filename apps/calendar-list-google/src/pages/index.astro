---
import { readSession } from '../lib/session.ts'

const session = readSession(Astro.cookies)
const authError = Astro.url.searchParams.has('auth_error')
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Tus próximos eventos de Google Calendar, en una lista clara." />
    <meta name="theme-color" content="#e85d3f" />
    <title>Renglón — Tu agenda, en limpio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,400;6..72,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class:list={{ authenticated: Boolean(session) }}>
    <div class="grain" aria-hidden="true"></div>

    {
      !session ? (
        <main class="login-shell">
          <nav class="brand-bar" aria-label="Navegación principal">
            <a class="brand" href="/" aria-label="Renglón, inicio">
              <span class="brand-mark">R</span>
              <span>RENGLÓN</span>
            </a>
            <span class="edition">ED. PERSONAL · 2026</span>
          </nav>

          <section class="login-grid">
            <div class="login-copy">
              <p class="eyebrow">GOOGLE CALENDAR, SIN LA CUADRÍCULA</p>
              <h1>
                Tu tiempo,
                <>
                  <br />
                  <em>puesto en limpio.</em>
                </>
              </h1>
              <p class="intro">
                Una lectura tranquila de lo que viene. Todos tus calendarios, una sola lista y control preciso sobre
                cada evento.
              </p>
              <a class="google-button" href="/api/auth/google">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    fill="#4285f4"
                    d="M21.6 12.23c0-.71-.06-1.4-.18-2.07H12v3.91h5.38a4.6 4.6 0 0 1-2 3.02v2.54h3.24c1.9-1.75 2.98-4.33 2.98-7.4Z"
                  />
                  <path
                    fill="#34a853"
                    d="M12 22c2.7 0 4.98-.9 6.63-2.37l-3.24-2.54c-.9.6-2.05.96-3.39.96-2.61 0-4.82-1.76-5.61-4.13H3.04v2.62A10 10 0 0 0 12 22Z"
                  />
                  <path
                    fill="#fbbc05"
                    d="M6.39 13.92A6.01 6.01 0 0 1 6.08 12c0-.67.11-1.32.31-1.92V7.46H3.04A10 10 0 0 0 2 12c0 1.61.38 3.14 1.04 4.54l3.35-2.62Z"
                  />
                  <path
                    fill="#ea4335"
                    d="M12 5.95c1.47 0 2.79.5 3.82 1.5l2.88-2.88A9.67 9.67 0 0 0 12 2a10 10 0 0 0-8.96 5.46l3.35 2.62C7.18 7.71 9.39 5.95 12 5.95Z"
                  />
                </svg>
                Continuar con Google
                <span>↗</span>
              </a>
              {authError && (
                <p class="auth-error" role="alert">
                  No pudimos completar el acceso. Inténtalo de nuevo.
                </p>
              )}
              <p class="privacy-note">
                Solo usamos el acceso para mostrar y borrar los eventos que tú elijas. Tus credenciales se mantienen en
                el servidor.
              </p>
            </div>

            <aside class="agenda-preview" aria-label="Vista previa de la aplicación">
              <div class="preview-heading">
                <span>PRÓXIMO</span>
                <span>03 EVENTOS</span>
              </div>
              <div class="preview-event featured">
                <div class="date-block">
                  <strong>29</strong>
                  <span>MAR</span>
                </div>
                <div>
                  <span class="preview-time">09:30 — 10:15</span>
                  <h2>Revisión del trimestre</h2>
                  <p>Estudio · Sala verde</p>
                </div>
              </div>
              <div class="preview-event">
                <div class="date-block">
                  <strong>29</strong>
                  <span>MAR</span>
                </div>
                <div>
                  <span class="preview-time">12:00 — 12:30</span>
                  <h2>
                    Café con Elena <span class="loop">↻ SERIE</span>
                  </h2>
                  <p>La Bicicleta · Madrid</p>
                </div>
              </div>
              <div class="preview-event faded">
                <div class="date-block">
                  <strong>30</strong>
                  <span>MAR</span>
                </div>
                <div>
                  <span class="preview-time">TODO EL DÍA</span>
                  <h2>Entrega editorial</h2>
                  <p>Trabajo</p>
                </div>
              </div>
              <p class="preview-caption">ORDENADO POR HORA · NO POR COLOR</p>
            </aside>
          </section>
        </main>
      ) : (
        <main class="app-shell">
          <header class="app-header">
            <a class="brand" href="/" aria-label="Renglón, inicio">
              <span class="brand-mark">R</span>
              <span>RENGLÓN</span>
            </a>
            <div class="user-menu">
              <div class="user-copy">
                <strong>{session.user.name}</strong>
                <span>{session.user.email}</span>
              </div>
              {session.user.picture ? (
                <img src={session.user.picture} width="42" height="42" alt="" referrerpolicy="no-referrer" />
              ) : (
                <span class="avatar-fallback">{session.user.name.slice(0, 1)}</span>
              )}
              <form action="/api/auth/logout" method="POST">
                <button class="logout" type="submit" aria-label="Cerrar sesión" title="Cerrar sesión">
                  ↗
                </button>
              </form>
            </div>
          </header>

          <section class="agenda">
            <div class="agenda-title">
              <div>
                <p class="eyebrow">TU AGENDA EN LISTA</p>
                <h1>Lo que viene.</h1>
              </div>
              <div class="calendar-control">
                <label for="calendar-select">CALENDARIO</label>
                <div class="select-wrap">
                  <span id="calendar-dot" class="calendar-dot" />
                  <select id="calendar-select" disabled>
                    <option>Cargando calendarios…</option>
                  </select>
                  <span class="select-arrow">↓</span>
                </div>
              </div>
            </div>

            <div class="list-toolbar">
              <label class="select-all">
                <input id="select-all" type="checkbox" />
                <span class="custom-check" />
                <span>SELECCIONAR TODO</span>
              </label>
              <p>
                <span id="event-count">—</span> PRÓXIMOS EVENTOS
              </p>
              <button id="delete-selected" class="delete-selected" type="button" disabled>
                ELIMINAR <span id="selected-count">0</span> <span aria-hidden="true">×</span>
              </button>
            </div>

            <div id="status" class="status" role="status" aria-live="polite">
              <span class="loader" />
              <span>Ordenando tu agenda…</span>
            </div>
            <div id="event-list" class="event-list" aria-live="polite" />
            <div id="load-more-status" class="load-more-status" role="status" aria-live="polite" hidden />
            <div id="events-sentinel" class="events-sentinel" aria-hidden="true" hidden />
          </section>
        </main>
      )
    }

    <dialog id="confirm-dialog" class="confirm-dialog">
      <form method="dialog">
        <button class="dialog-close" value="cancel" aria-label="Cerrar">×</button>
        <p class="eyebrow">CONFIRMAR BORRADO</p>
        <h2 id="dialog-title">¿Eliminar este evento?</h2>
        <p id="dialog-copy">Esta acción no se puede deshacer.</p>
        <div class="dialog-actions">
          <button value="cancel" class="button-secondary">CANCELAR</button>
          <button id="confirm-delete" value="confirm" class="button-danger">ELIMINAR</button>
        </div>
      </form>
    </dialog>

    {session && <script src="../scripts/agenda.ts" />}
  </body>
</html>

<style is:global>
  :root {
    --ink: #1c1b19;
    --paper: #f3f0e8;
    --paper-deep: #e8e3d7;
    --coral: #e85d3f;
    --acid: #d7ea48;
    --line: rgba(28, 27, 25, 0.2);
    --muted: #6c6961;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--paper);
    color: var(--ink);
    font-family: 'DM Mono', monospace;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background: linear-gradient(90deg, transparent 49.9%, rgba(28, 27, 25, 0.045) 50%, transparent 50.1%), var(--paper);
  }

  button,
  select {
    font: inherit;
  }

  button,
  a,
  select,
  input {
    -webkit-tap-highlight-color: transparent;
  }

  .grain {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 20;
    opacity: 0.22;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.12'/%3E%3C/svg%3E");
  }

  .brand-bar,
  .app-header {
    min-height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--ink);
  }

  .brand-bar {
    padding: 0 5vw;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: inherit;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-decoration: none;
  }

  .brand-mark {
    width: 31px;
    height: 31px;
    display: grid;
    place-items: center;
    background: var(--ink);
    border-radius: 50%;
    color: var(--paper);
    font-family: 'Newsreader', serif;
    font-size: 18px;
    letter-spacing: 0;
  }

  .edition,
  .eyebrow {
    font-size: 10px;
    letter-spacing: 0.13em;
  }

  .login-shell {
    min-height: 100vh;
    overflow: hidden;
  }

  .login-grid {
    min-height: calc(100vh - 88px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(440px, 0.74fr);
  }

  .login-copy {
    padding: clamp(64px, 8vw, 128px) 7vw 60px 9vw;
    animation: reveal 700ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .eyebrow {
    margin: 0 0 24px;
    color: var(--coral);
    font-weight: 500;
  }

  .login-copy h1,
  .agenda-title h1 {
    margin: 0;
    font-family: 'Newsreader', serif;
    font-size: clamp(60px, 7.2vw, 116px);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 0.88;
  }

  .login-copy h1 em {
    color: var(--coral);
    font-weight: 400;
  }

  .intro {
    max-width: 560px;
    margin: 45px 0 34px;
    font-family: 'Newsreader', serif;
    font-size: clamp(20px, 1.8vw, 27px);
    line-height: 1.35;
  }

  .google-button {
    width: min(100%, 430px);
    min-height: 62px;
    display: grid;
    grid-template-columns: 26px 1fr auto;
    align-items: center;
    gap: 18px;
    padding: 0 22px;
    background: var(--ink);
    color: white;
    border: 1px solid var(--ink);
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 0.08em;
    transition:
      transform 180ms ease,
      background 180ms ease,
      color 180ms ease;
  }

  .google-button:hover {
    transform: translate(-4px, -4px);
    box-shadow: 4px 4px 0 var(--coral);
  }

  .google-button svg {
    width: 24px;
    padding: 3px;
    background: white;
    border-radius: 50%;
  }

  .auth-error {
    color: #a52c18;
    font-size: 11px;
  }

  .privacy-note {
    max-width: 430px;
    margin-top: 18px;
    color: var(--muted);
    font-size: 9px;
    line-height: 1.7;
  }

  .agenda-preview {
    position: relative;
    padding: clamp(65px, 9vw, 135px) clamp(35px, 5vw, 80px) 60px;
    background: var(--coral);
    color: #211511;
    animation: slide-in 800ms 120ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .preview-heading,
  .preview-caption {
    display: flex;
    justify-content: space-between;
    font-size: 9px;
    letter-spacing: 0.12em;
  }

  .preview-heading {
    padding-bottom: 18px;
    border-bottom: 1px solid;
  }

  .preview-event {
    display: grid;
    grid-template-columns: 68px 1fr;
    gap: 18px;
    padding: 27px 0;
    border-bottom: 1px solid rgba(28, 27, 25, 0.55);
  }

  .preview-event.featured {
    background: var(--acid);
    margin: 0 -20px;
    padding-inline: 20px;
    transform: rotate(-1deg);
    box-shadow: 9px 10px 0 rgba(28, 27, 25, 0.12);
  }

  .preview-event.faded {
    opacity: 0.52;
  }

  .date-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    border-right: 1px solid;
  }

  .date-block strong {
    font-family: 'Newsreader', serif;
    font-size: 44px;
    font-weight: 400;
    line-height: 0.9;
  }

  .date-block span,
  .preview-time {
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .preview-event h2 {
    margin: 9px 0 7px;
    font-family: 'Newsreader', serif;
    font-size: clamp(22px, 2vw, 30px);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .preview-event p {
    margin: 0;
    font-size: 10px;
  }

  .loop {
    display: inline-block;
    padding: 4px 6px;
    border: 1px solid;
    font-family: 'DM Mono', monospace;
    font-size: 7px;
    letter-spacing: 0.08em;
    vertical-align: middle;
  }

  .preview-caption {
    position: absolute;
    right: 5vw;
    bottom: 27px;
    left: 5vw;
  }

  .app-shell {
    width: min(1440px, 100%);
    min-height: 100vh;
    margin: 0 auto;
    padding: 0 clamp(22px, 5vw, 76px) 80px;
  }

  .app-header {
    margin-bottom: clamp(64px, 9vw, 126px);
  }

  .user-menu {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .user-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-size: 9px;
    line-height: 1.6;
  }

  .user-copy strong {
    font-size: 10px;
    text-transform: uppercase;
  }

  .user-copy span {
    color: var(--muted);
  }

  .user-menu img,
  .avatar-fallback {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--coral);
    object-fit: cover;
    font-family: 'Newsreader', serif;
    font-size: 21px;
  }

  .user-menu form {
    display: contents;
  }

  .logout {
    width: 30px;
    height: 30px;
    border: 0;
    background: transparent;
    cursor: pointer;
    font-size: 18px;
    transition: transform 150ms;
  }

  .logout:hover {
    transform: translate(2px, -2px);
  }

  .agenda-title {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 55px;
    animation: reveal 500ms ease both;
  }

  .agenda-title h1 {
    font-size: clamp(58px, 8vw, 106px);
  }

  .calendar-control {
    width: min(360px, 100%);
  }

  .calendar-control label {
    display: block;
    margin-bottom: 9px;
    font-size: 9px;
    letter-spacing: 0.12em;
  }

  .select-wrap {
    position: relative;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--ink);
  }

  .calendar-dot {
    width: 9px;
    height: 9px;
    flex: 0 0 auto;
    background: var(--coral);
    border-radius: 50%;
  }

  #calendar-select {
    width: 100%;
    padding: 12px 36px 12px 13px;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
    appearance: none;
    cursor: pointer;
    font-family: 'Newsreader', serif;
    font-size: 20px;
  }

  .select-arrow {
    position: absolute;
    right: 3px;
    pointer-events: none;
  }

  .list-toolbar {
    min-height: 46px;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: center;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .list-toolbar p {
    margin: 0;
    text-align: center;
  }

  .select-all {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
  }

  .select-all input,
  .event-checkbox input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .custom-check {
    width: 17px;
    height: 17px;
    display: inline-grid;
    place-items: center;
    border: 1px solid var(--ink);
  }

  input:checked + .custom-check {
    background: var(--ink);
  }

  input:checked + .custom-check::after {
    content: '✓';
    color: var(--paper);
    font-size: 11px;
  }

  .delete-selected {
    justify-self: end;
    padding: 8px 0;
    border: 0;
    border-bottom: 1px solid currentColor;
    background: transparent;
    color: var(--coral);
    cursor: pointer;
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .delete-selected:disabled {
    color: var(--muted);
    cursor: not-allowed;
    opacity: 0.5;
  }

  .status {
    min-height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    color: var(--muted);
    font-size: 10px;
  }

  .status[hidden] {
    display: none;
  }

  .status.error {
    color: #a52c18;
  }

  .load-more-status {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    color: var(--muted);
    font-size: 10px;
  }

  .load-more-status[hidden],
  .events-sentinel[hidden] {
    display: none;
  }

  .load-more-status.error {
    color: #a52c18;
  }

  .events-sentinel {
    height: 1px;
  }

  .loader {
    width: 15px;
    height: 15px;
    border: 1px solid var(--line);
    border-top-color: var(--coral);
    border-radius: 50%;
    animation: spin 700ms linear infinite;
  }

  .month-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 45px 0 14px;
    border-bottom: 1px solid var(--ink);
  }

  .month-heading h2 {
    margin: 0;
    font-family: 'Newsreader', serif;
    font-size: 30px;
    font-weight: 400;
  }

  .month-heading span {
    color: var(--muted);
    font-size: 8px;
    letter-spacing: 0.1em;
  }

  .event-row {
    position: relative;
    display: grid;
    grid-template-columns: 42px 78px minmax(0, 1.4fr) minmax(160px, 0.7fr) 44px;
    align-items: center;
    gap: 22px;
    min-height: 112px;
    border-bottom: 1px solid var(--line);
    transition:
      background 160ms ease,
      padding 160ms ease;
    animation: reveal 420ms both;
  }

  .event-row:hover,
  .event-row.selected {
    margin-inline: -12px;
    padding-inline: 12px;
    background: rgba(215, 234, 72, 0.2);
  }

  .event-checkbox {
    display: grid;
    cursor: pointer;
  }

  .event-date {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--line);
  }

  .event-date strong {
    font-family: 'Newsreader', serif;
    font-size: 42px;
    font-weight: 400;
    line-height: 0.9;
  }

  .event-date span,
  .event-time {
    margin-top: 7px;
    color: var(--muted);
    font-size: 8px;
    letter-spacing: 0.08em;
  }

  .event-title {
    min-width: 0;
  }

  .event-title h3 {
    margin: 0 0 8px;
    overflow: hidden;
    font-family: 'Newsreader', serif;
    font-size: clamp(20px, 2.2vw, 29px);
    font-weight: 600;
    letter-spacing: -0.025em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .series-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-left: 8px;
    padding: 4px 6px;
    border: 1px solid var(--coral);
    color: var(--coral);
    font-family: 'DM Mono', monospace;
    font-size: 7px;
    letter-spacing: 0.08em;
    vertical-align: middle;
  }

  .event-title p {
    margin: 0;
    overflow: hidden;
    color: var(--muted);
    font-size: 9px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .event-time {
    margin: 0;
    color: var(--ink);
    line-height: 1.6;
  }

  .event-time span {
    display: block;
    color: var(--muted);
  }

  .event-delete {
    width: 38px;
    height: 38px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font-size: 18px;
    transition:
      border 140ms,
      color 140ms,
      transform 140ms;
  }

  .event-delete:hover {
    border-color: var(--coral);
    color: var(--coral);
    transform: rotate(6deg);
  }

  .empty-state {
    padding: 100px 20px;
    text-align: center;
  }

  .empty-state strong {
    display: block;
    font-family: 'Newsreader', serif;
    font-size: 32px;
    font-weight: 400;
  }

  .empty-state span {
    display: block;
    margin-top: 12px;
    color: var(--muted);
    font-size: 9px;
  }

  .confirm-dialog {
    width: min(470px, calc(100% - 32px));
    padding: 0;
