<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Crea un calendario anual de custodia compartida con semanas, rotaciones y vacaciones configurables."
    />
    <meta name="theme-color" content="#163a35" />
    <title>Turnos — Calendario compartido</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,400;6..72,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>

    <header class="site-header">
      <a class="brand" href="/custodia" aria-label="Turnos, inicio">
        <span class="brand-mark">R</span>
        <span>TURNOS</span>
      </a>
      <nav aria-label="Navegación principal">
        <span aria-current="page">CUSTODIA</span>
      </nav>
      <div class="header-actions">
        <p id="calendar-edition" class="edition">DESDE 26·09·2022</p>
        <button id="open-config" class="config-trigger" type="button">CONFIGURAR ↗</button>
      </div>
    </header>

    <main>
      <section class="intro" aria-labelledby="page-title">
        <div class="intro-copy">
          <p id="schedule-eyebrow" class="eyebrow">SEMANAS ALTERNAS · CAMBIO EN LUNES</p>
          <h1 id="page-title"><span id="calendar-title">El tiempo</span>,<br /><em>bien repartido.</em></h1>
        </div>

        <aside class="rule-card" aria-label="Regla aplicada">
          <span class="rule-number">01</span>
          <div>
            <strong id="rule-title">La semana 1 rota cada año.</strong>
            <p id="rule-description">La primera persona comienza en 2022 y el inicio se intercambia cada año ISO.</p>
          </div>
        </aside>
      </section>

      <section class="calendar-key" aria-label="Leyenda del calendario">
        <div class="legend-item father">
          <span class="swatch"></span>
          <div><strong id="father-legend">PERSONA A</strong><small>primer turno</small></div>
        </div>
        <div class="legend-item mother">
          <span class="swatch"></span>
          <div><strong id="mother-legend">PERSONA B</strong><small>segundo turno</small></div>
        </div>
        <div class="legend-item summer">
          <span class="swatch"></span>
          <div><strong>VERANO</strong><small>quincenas · cambio 19h</small></div>
        </div>
        <div class="legend-item school-break" hidden>
          <span class="swatch"></span>
          <div><strong>NO LECTIVO</strong><small>vacación, festivo o puente</small></div>
        </div>
        <p><span>NOTA</span> Los periodos no lectivos configurados suspenden o aplazan el turno semanal.</p>
        <div class="year-controls" aria-label="Cambiar el año mostrado">
          <button id="previous-year" type="button" aria-label="Mostrar el año anterior">←</button>
          <button id="current-year" type="button" title="Volver al año actual"
            ><span>AÑO</span><strong id="active-year">2026</strong></button
          >
          <button id="next-year" type="button" aria-label="Mostrar el año siguiente">→</button>
        </div>
      </section>

      <div id="calendar-years" class="calendar-years" aria-live="polite"></div>
    </main>

    <dialog id="config-dialog" class="config-dialog" aria-labelledby="config-title">
      <form id="config-form" method="dialog">
        <aside class="config-rail">
          <div>
            <p class="eyebrow">CONFIGURACIÓN LOCAL</p>
            <h2 id="config-title">Tu calendario,<br /><em>tus reglas.</em></h2>
          </div>
          <ol class="config-progress" aria-label="Pasos de configuración">
            <li class="active" data-progress-step="0"><span>01</span> Personas</li>
            <li data-progress-step="1"><span>02</span> Semanas</li>
            <li data-progress-step="2"><span>03</span> Verano</li>
            <li data-progress-step="3"><span>04</span> Calendario escolar</li>
            <li data-progress-step="4"><span>05</span> Revisar</li>
          </ol>
          <p class="storage-note">Se guarda únicamente en este navegador. No enviamos estos datos a ningún servidor.</p>
        </aside>

        <div class="config-content">
          <button id="close-config" class="config-close" type="button" aria-label="Cerrar configuración">×</button>

          <section class="config-step" data-config-step="0">
            <p class="step-kicker">01 · IDENTIDAD</p>
            <h3>¿Cómo llamamos a cada turno?</h3>
            <div class="form-grid">
              <label class="field field-wide">
                <span>NOMBRE DEL CALENDARIO</span>
                <input
                  id="config-title-input"
                  name="title"
                  type="text"
                  maxlength="50"
                  placeholder="Custodia compartida"
                />
              </label>
              <label class="field">
                <span>PERSONA A · COLOR DEL CALENDARIO</span>
                <span class="color-field"
                  ><input id="father-color" name="fatherColor" type="color" /><input
                    id="father-name"
                    name="fatherName"
                    type="text"
                    maxlength="24"
                    required
                  /></span
                >
              </label>
              <label class="field">
                <span>PERSONA B · COLOR DEL CALENDARIO</span>
                <span class="color-field"
                  ><input id="mother-color" name="motherColor" type="color" /><input
                    id="mother-name"
                    name="motherName"
                    type="text"
                    maxlength="24"
                    required
                  /></span
                >
              </label>
              <label class="field field-wide">
                <span>ZONA HORARIA</span>
                <input id="config-timezone" name="timezone" type="text" list="timezone-options" required />
                <datalist id="timezone-options"
                  ><option value="Europe/Madrid"></option><option value="Europe/London"></option><option
                    value="America/Mexico_City"></option><option value="America/Argentina/Buenos_Aires"></option><option
                    value="UTC"></option></datalist
                >
              </label>
            </div>
          </section>

          <section class="config-step" data-config-step="1" hidden>
            <p class="step-kicker">02 · RÉGIMEN ORDINARIO</p>
            <h3>Define el ritmo semanal.</h3>
            <div class="form-grid">
              <label class="field"
                ><span>FECHA DE INICIO</span><input
                  id="schedule-start-date"
                  name="startDate"
                  type="date"
                  required
                /></label
              >
              <label class="field"
                ><span>EMPIEZA</span><select id="schedule-starts-with" name="startsWith"
                  ><option value="father">Persona A</option><option value="mother">Persona B</option></select
                ></label
              >
              <label class="field"
                ><span>DÍA DE CAMBIO</span><select id="exchange-weekday" name="exchangeWeekday"
                  ><option value="1">Lunes</option><option value="2">Martes</option><option value="3">Miércoles</option
                  ><option value="4">Jueves</option><option value="5">Viernes</option><option value="6">Sábado</option
                  ><option value="0">Domingo</option></select
                ></label
              >
              <label class="field"
                ><span>HORA DE CAMBIO</span><input id="exchange-time" name="exchangeTime" type="time" required /></label
              >
              <label class="field"
                ><span>DURACIÓN DEL TURNO</span><span class="input-suffix"
                  ><input id="turn-weeks" name="turnWeeks" type="number" min="1" max="8" required /><small
                    >SEMANAS</small
                  ></span
                ></label
              >
              <label class="field"
                ><span>ROTACIÓN</span><select id="schedule-rotation" name="rotation"
                  ><option value="annual">Anual · cambia semana 1</option><option value="continuous"
                    >Continua desde el inicio</option
                  ></select
                ></label
              >
              <label class="field field-wide"
                ><span>SEMANA 53</span><select id="week-53-strategy" name="week53Strategy"
                  ><option value="continue">Continúa la alternancia</option><option value="same-as-52"
                    >Mantiene el turno de la semana 52</option
                  ></select
                ></label
              >
            </div>
          </section>

          <section class="config-step" data-config-step="2" hidden>
            <p class="step-kicker">03 · VACACIONES</p>
            <h3>Configura el verano.</h3>
            <label class="summer-toggle"
              ><input id="summer-enabled" name="summerEnabled" type="checkbox" /><span></span><strong
                >APLICAR UN RÉGIMEN ESPECIAL EN VERANO</strong
              ></label
            >
            <fieldset id="summer-fields" class="summer-fields">
              <div class="form-grid">
                <label class="field"
                  ><span>PRIMER MES</span><select id="summer-start-month" name="summerStartMonth"></select></label
                >
                <label class="field"
                  ><span>ÚLTIMO MES</span><select id="summer-end-month" name="summerEndMonth"></select></label
                >
                <label class="field"
                  ><span>INICIO DE PERIODOS</span><input
                    id="summer-split-days"
                    name="summerSplitDays"
                    type="text"
                    placeholder="1, 16"
                    required
                  /><small>Separados por comas</small></label
                >
                <label class="field"
                  ><span>HORA DE CAMBIO</span><input
                    id="summer-exchange-time"
                    name="summerExchangeTime"
                    type="time"
                    required
                  /></label
                >
                <label class="field"
                  ><span>AÑOS PARES EMPIEZA</span><select id="summer-even-starts-with" name="summerEvenStartsWith"
                    ><option value="father">Persona A</option><option value="mother">Persona B</option></select
                  ></label
                >
                <label class="field"
                  ><span>AL TERMINAR</span><select id="summer-resume-strategy" name="summerResumeStrategy"
                    ><option value="opposite-last-period">Quien no tuvo el último periodo, hasta el cambio</option
                    ><option value="preserve">Recuperar el calendario semanal</option><option value="restart"
                      >Reiniciar la alternancia</option
                    ></select
                  ></label
                >
              </div>
            </fieldset>
          </section>

          <section class="config-step school-calendar-step" data-config-step="3" hidden>
            <p class="step-kicker">04 · CALENDARIO ESCOLAR</p>
            <h3>Añade las fechas de cada curso.</h3>
            <p class="step-copy">
              Solo necesitas consultar el último día de clase y el primer día de regreso. Calcularemos el 30 de
              diciembre o el Miércoles Santo según corresponda; podrás corregir el resultado antes de guardar.
            </p>

            <div class="rule-builder">
              <header>
                <div class="rule-builder-copy">
                  <strong>VACACIONES</strong><p>
                    Añade un curso completo cada año. Navidad y Semana Santa quedarán agrupadas sin borrar los cursos
                    anteriores.
                  </p>
                </div>
                <div class="school-year-adder">
                  <label class="field">
                    <span>CURSO QUE EMPIEZA EN</span>
                    <span class="school-year-input"
                      ><input id="school-year-start" type="number" min="2000" max="2100" step="1" required /><strong
                        id="school-year-preview">/ 27</strong
                      ></span
                    >
                  </label>
                  <button id="add-school-year" type="button">+ AÑADIR CURSO</button>
                </div>
              </header>
              <div id="vacation-period-list" class="rule-list"></div>
            </div>

            <div class="rule-builder">
              <header>
                <div>
                  <strong>FESTIVOS Y PUENTES</strong><p>
                    Indica el intervalo no lectivo completo. Si incluye el día de cambio, este se retrasa a las 09:00
                    del primer día posterior.
                  </p>
                </div>
                <button id="add-non-school" type="button">+ AÑADIR</button>
              </header>
              <div id="non-school-period-list" class="rule-list"></div>
            </div>
          </section>

          <section class="config-step review-step" data-config-step="4" hidden>
            <p class="step-kicker">05 · REVISIÓN</p>
            <h3>Comprueba las reglas.</h3>
            <div id="config-summary" class="config-summary"></div>
            <p class="privacy-callout">
              <strong>PRIVACIDAD</strong> Esta configuración quedará en <code>localStorage</code>. Borrar los datos del
              navegador también borrará el calendario guardado.
            </p>
          </section>

          <p id="config-error" class="config-error" role="alert" hidden></p>
          <footer class="config-footer">
            <button id="reset-config" class="text-button" type="button">RESTABLECER</button>
            <span></span>
            <button id="previous-step" class="button-ghost" type="button" hidden>← ANTERIOR</button>
            <button id="next-step" class="button-primary" type="button">SIGUIENTE →</button>
            <button id="save-config" class="button-primary" type="submit" hidden>GUARDAR CALENDARIO</button>
          </footer>
        </div>
      </form>
    </dialog>

    <script src="../scripts/custody-calendar.ts"></script>
  </body>
</html>

<style is:global>
  :root {
    --ink: #17201e;
    --paper: #f2eee3;
    --paper-deep: #e6dfd0;
    --father: #174c43;
    --father-soft: #c9ddd5;
    --mother: #db644d;
    --mother-soft: #f1c8b9;
    --acid: #d9e64d;
    --line: rgba(23, 32, 30, 0.22);
    --muted: #6d6b62;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    background: var(--paper);
    color: var(--ink);
    font-family: 'DM Mono', monospace;
  }

  body {
    margin: 0;
    min-width: 320px;
    min-height: 100vh;
    background: linear-gradient(90deg, transparent 49.9%, rgba(23, 32, 30, 0.045) 50%, transparent 50.1%), var(--paper);
  }

  button,
  a {
    color: inherit;
    font: inherit;
    -webkit-tap-highlight-color: transparent;
  }

  .grain {
    position: fixed;
    z-index: 20;
    inset: 0;
    pointer-events: none;
    opacity: 0.2;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.88' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.11'/%3E%3C/svg%3E");
  }

  .site-header {
    width: min(1600px, calc(100% - 48px));
    min-height: 82px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    margin: 0 auto;
    border-bottom: 1px solid var(--ink);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    justify-self: start;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-decoration: none;
  }

  .brand-mark {
    width: 31px;
    height: 31px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-family: 'Newsreader', serif;
    font-size: 18px;
    letter-spacing: 0;
  }

  .site-header nav {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 9px;
    letter-spacing: 0.13em;
  }

  .site-header nav a {
    color: var(--muted);
    text-decoration: none;
  }

  .site-header nav a:hover {
    color: var(--ink);
  }

  .site-header nav span {
    padding-block: 8px;
    border-bottom: 2px solid var(--mother);
  }

  .edition {
    margin: 0;
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 0.11em;
  }

  .header-actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 22px;
  }

  .config-trigger {
    padding: 9px 0;
    border: 0;
    border-bottom: 1px solid currentColor;
    background: transparent;
    cursor: pointer;
    font-size: 8px;
    letter-spacing: 0.1em;
  }

  main {
    width: min(1600px, calc(100% - 48px));
    margin: 0 auto;
    padding-bottom: 100px;
  }

  .intro {
    min-height: min(560px, 66vh);
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(310px, 0.6fr);
    align-items: end;
    gap: clamp(50px, 8vw, 140px);
    padding: clamp(80px, 10vw, 150px) 4vw 75px;
  }

  .eyebrow {
    margin: 0 0 22px;
    color: var(--mother);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.14em;
  }

  .intro h1 {
    margin: 0;
    font-family: 'Newsreader', serif;
    font-size: clamp(64px, 8.5vw, 142px);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 0.83;
    animation: reveal 650ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .intro h1 em {
    color: var(--father);
    font-weight: 400;
  }

  .rule-card {
    position: relative;
    display: grid;
    grid-template-columns: 54px 1fr;
    gap: 20px;
    padding: 28px;
    border: 1px solid var(--ink);
    background: var(--acid);
    box-shadow: 9px 9px 0 var(--ink);
    transform: rotate(1.2deg);
    animation: reveal 650ms 120ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .rule-number {
    font-family: 'Newsreader', serif;
    font-size: 38px;
    line-height: 1;
  }

  .rule-card strong {
    font-family: 'Newsreader', serif;
    font-size: 23px;
    line-height: 1.1;
  }

  .rule-card p {
    margin: 12px 0 0;
    font-size: 9px;
    line-height: 1.7;
  }

  .calendar-key {
    position: sticky;
    z-index: 10;
    top: 0;
    min-height: 68px;
    display: grid;
    grid-template-columns: auto auto auto auto 1fr auto;
    align-items: center;
    gap: 30px;
    padding: 11px 18px;
    border-block: 1px solid var(--ink);
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    backdrop-filter: blur(10px);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .legend-item[hidden] {
    display: none;
  }

  .swatch {
    width: 28px;
    height: 28px;
    border: 1px solid var(--ink);
    border-radius: 50%;
  }

  .legend-item.father .swatch {
    background: var(--father-soft);
  }

  .legend-item.mother .swatch {
    background: var(--mother-soft);
  }

  .legend-item.summer .swatch {
    background:
      repeating-linear-gradient(135deg, transparent 0 5px, rgba(242, 238, 227, 0.48) 5px 7px),
      linear-gradient(90deg, var(--father-soft) 50%, var(--mother-soft) 50%);
    box-shadow: inset 0 -2px 0 var(--ink);
  }

  .legend-item.school-break .swatch {
    background: repeating-linear-gradient(-45deg, transparent 0 4px, rgba(23, 32, 30, 0.16) 4px 6px), var(--acid);
  }

  .legend-item div {
    display: flex;
    flex-direction: column;
    font-size: 9px;
    letter-spacing: 0.1em;
  }

  .legend-item small {
    margin-top: 3px;
    color: var(--muted);
    font-size: 7px;
    letter-spacing: 0;
  }

  .calendar-key > p {
    margin: 0;
    color: var(--muted);
    font-size: 8px;
    line-height: 1.5;
    text-align: center;
  }

  .calendar-key > p span {
    margin-right: 8px;
    color: var(--mother);
  }

  .year-controls {
    display: grid;
    grid-template-columns: 34px auto 34px;
    align-items: stretch;
    border: 1px solid var(--ink);
  }

  .year-controls button {
    min-height: 38px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .year-controls > button:first-child {
    border-right: 1px solid var(--ink);
  }

  .year-controls > button:last-child {
    border-left: 1px solid var(--ink);
  }

  .year-controls > button:first-child:hover,
  .year-controls > button:last-child:hover {
    background: var(--acid);
  }

  .year-controls button:disabled {
    cursor: not-allowed;
    opacity: 0.25;
  }

  #current-year {
    min-width: 66px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
  }

  #current-year span {
    color: var(--muted);
    font-size: 5px;
    letter-spacing: 0.12em;
  }

  #current-year strong {
    font-family: 'Newsreader', serif;
    font-size: 17px;
    line-height: 1;
  }

  .year-calendar {
    scroll-margin-top: 90px;
    display: grid;
    grid-template-columns: minmax(120px, 0.18fr) minmax(0, 1fr);
    gap: clamp(30px, 5vw, 85px);
    padding: clamp(75px, 9vw, 145px) 0;
    border-bottom: 1px solid var(--ink);
  }

  .year-heading {
    position: relative;
  }

  .year-heading div {
    position: sticky;
    top: 105px;
  }

  .year-heading h2 {
    margin: 0;
    font-family: 'Newsreader', serif;
    font-size: clamp(70px, 9vw, 150px);
    font-weight: 400;
    letter-spacing: -0.07em;
    line-height: 0.8;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .year-heading p {
    width: min-content;
    margin: 24px 0 0;
    color: var(--muted);
    font-size: 8px;
    line-height: 1.6;
    letter-spacing: 0.1em;
  }

  .year-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    margin-top: 24px;
  }

  .year-meta p {
    margin: 0;
  }

  .year-starter {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 9px;
    border: 1px solid var(--ink);
    font-size: 7px;
    line-height: 1;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .year-starter::before {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    content: '';
  }

  .year-starter.father::before {
    background: var(--father);
  }

  .year-starter.mother::before {
    background: var(--mother);
  }

  .months-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 56px clamp(24px, 3.2vw, 54px);
  }

  .month {
    min-width: 0;
    animation: reveal 450ms both;
  }

  .month-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    min-height: 39px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--ink);
  }

  .month-header h3 {
    margin: 0;
    font-family: 'Newsreader', serif;
    font-size: clamp(22px, 2vw, 31px);
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  .month-header span {
    color: var(--muted);
