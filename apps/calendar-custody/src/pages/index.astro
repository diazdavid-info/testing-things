---
import Icon from '../components/Icon.astro'

const weekdayLabels = ['L', 'M', 'X', 'J', 'V', 'S', 'D']
const weekdayOptions = [
  { label: 'L', name: 'Lunes', value: 1 },
  { label: 'M', name: 'Martes', value: 2 },
  { label: 'X', name: 'Miércoles', value: 3 },
  { label: 'J', name: 'Jueves', value: 4 },
  { label: 'V', name: 'Viernes', value: 5 },
  { label: 'S', name: 'Sábado', value: 6 },
  { label: 'D', name: 'Domingo', value: 0 },
]
const steps = [
  { label: 'Personas', description: 'Nombres y colores' },
  { label: 'Semanas', description: 'Ritmo y hora de cambio' },
  { label: 'Verano', description: 'Periodos y horarios' },
  { label: 'Revisar', description: 'Comprobar y guardar' },
]
const people = [
  {
    id: 'father',
    title: 'Persona A',
    turn: 'Primer turno',
    initial: 'P',
    swatches: [
      { name: 'Azul cielo', color: '#a9cbf4' },
      { name: 'Salvia', color: '#b9dcc4' },
      { name: 'Lavanda', color: '#cec5f3' },
      { name: 'Rosa', color: '#f7c5d5' },
    ],
  },
  {
    id: 'mother',
    title: 'Persona B',
    turn: 'Segundo turno',
    initial: 'M',
    swatches: [
      { name: 'Melocotón', color: '#ffd3b6' },
      { name: 'Mostaza', color: '#f6de9a' },
      { name: 'Rosa', color: '#f7c5d5' },
      { name: 'Salvia', color: '#b9dcc4' },
    ],
  },
]
const months = [
  'Enero',
  'Febrero',
  'Marzo',
  'Abril',
  'Mayo',
  'Junio',
  'Julio',
  'Agosto',
  'Septiembre',
  'Octubre',
  'Noviembre',
  'Diciembre',
]
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Crea un calendario anual de custodia compartida con semanas, rotaciones y vacaciones configurables."
    />
    <meta name="theme-color" content="#f3f5fa" />
    <title>Turnos — Calendario compartido</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="page">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Turnos, inicio">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>Turnos</span>
        </a>
        <div class="header-actions">
          <p class="privacy-pill"><Icon name="lock" size={16} />Guardado solo en este navegador</p>
          <button id="today-button" class="icon-button header-today" type="button" aria-label="Ir a hoy">
            <Icon name="calendar-days" size={20} />
          </button>
          <button id="open-config" class="button button-primary config-trigger" type="button" aria-label="Configurar">
            <Icon name="sliders-horizontal" />
            <span>Configurar</span>
          </button>
        </div>
      </header>

      <main class="dashboard">
        <section class="hero" aria-labelledby="page-title">
          <div class="hero-copy">
            <p class="eyebrow-pill">
              <Icon name="repeat" size={16} /><span id="schedule-eyebrow">Semanas alternas</span>
            </p>
            <h1 id="page-title">
              <span id="calendar-title">El tiempo</span>,{' '}<br />
              <span class="underline">bien repartido.</span>
            </h1>
            <p class="hero-lead">
              Consulta de un vistazo a quién le toca cada día, cuándo es el próximo cambio y cómo se reparten las
              vacaciones.
            </p>
          </div>

          <article id="now-card" class="now-card" aria-labelledby="now-date">
            <div class="now-top">
              <p id="now-date" class="overline">Hoy</p>
              <p class="now-live">En curso</p>
            </div>
            <div class="now-who">
              <span id="now-avatar" class="avatar avatar-lg" aria-hidden="true"></span>
              <div>
                <p id="now-label" class="now-label">Hoy está con</p>
                <p id="now-name" class="now-name"></p>
              </div>
            </div>
            <div class="now-progress">
              <div class="now-progress-text"><span id="now-progress-label"></span><span id="now-remaining"></span></div>
              <div id="now-segments" class="segments" aria-hidden="true"></div>
            </div>
            <button id="now-next" class="next-change" type="button">
              <span class="avatar-pair" aria-hidden="true">
                <span id="next-from" class="avatar avatar-sm"></span>
                <span id="next-to" class="avatar avatar-sm"></span>
              </span>
              <span class="next-change-text">
                <span class="next-change-label">Próximo cambio</span>
                <strong id="next-when"></strong>
                <span id="next-sub"></span>
              </span>
              <span class="next-change-icon"><Icon name="chevron-right" /></span>
            </button>
          </article>
        </section>

        <section class="mobile-month card" aria-labelledby="mobile-month-title">
          <div class="month-nav">
            <button id="previous-month" class="icon-button" type="button" aria-label="Mes anterior">
              <Icon name="chevron-left" size={20} />
            </button>
            <div>
              <h2 id="mobile-month-title" aria-live="polite"></h2>
              <p id="mobile-month-meta"></p>
            </div>
            <button id="next-month" class="icon-button" type="button" aria-label="Mes siguiente">
              <Icon name="chevron-right" size={20} />
            </button>
          </div>
          <div class="month-grid">
            <span class="week-corner" aria-hidden="true">Sem</span>
            <div class="weekdays" aria-hidden="true">{weekdayLabels.map((label) => <span>{label}</span>)}</div>
            <div id="mobile-week-numbers" class="week-numbers" aria-hidden="true"></div>
            <div id="mobile-month-days" class="month-days"></div>
          </div>
          <ul class="legend legend-compact" aria-label="Leyenda">
            <li><span class="legend-swatch is-father"></span><span data-person-name="father">Papá</span></li>
            <li><span class="legend-swatch is-mother"></span><span data-person-name="mother">Mamá</span></li>
            <li><span class="legend-swatch legend-swatch-change"></span>Cambio</li>
            <li data-legend="summer"><span class="legend-swatch legend-swatch-summer"></span>Verano</li>
            <li data-legend="non-school"><span class="legend-swatch legend-swatch-non-school"></span>Festivo</li>
            <li data-legend="holiday"><span class="legend-swatch legend-swatch-holiday"></span>Vacaciones</li>
            <li><span class="legend-swatch legend-swatch-today"></span>Hoy</li>
          </ul>
        </section>

        <section class="overview" aria-label="Resumen">
          <article class="card upcoming-card">
            <header class="card-header">
              <span class="card-icon"><Icon name="arrow-left-right" /></span>
              <h2>Próximos cambios</h2>
            </header>
            <ul id="upcoming-list" class="upcoming-list"></ul>
          </article>

          <article class="card share-card">
            <header class="card-header">
              <span class="card-icon"><Icon name="pie-chart" /></span>
              <h2>Reparto de <span id="share-year"></span></h2>
            </header>
            <div class="share-numbers">
              <div class="is-father">
                <p class="share-person">
                  <span class="share-swatch"></span><span data-person-name="father">Papá</span>
                </p>
                <p class="share-value"><strong id="share-father-days">0</strong> días</p>
              </div>
              <div class="is-mother">
                <p class="share-person">
                  <span data-person-name="mother">Mamá</span><span class="share-swatch"></span>
                </p>
                <p class="share-value"><strong id="share-mother-days">0</strong> días</p>
              </div>
            </div>
            <div id="share-bar" class="share-bar" aria-hidden="true"><span></span><span></span></div>
            <div class="share-percent">
              <span id="share-father-percent"></span><span id="share-mother-percent"></span>
            </div>
            <p class="card-note">Incluye el verano, las vacaciones escolares y los festivos configurados.</p>
          </article>

          <article class="card rules-card">
            <header class="card-header">
              <span class="card-icon"><Icon name="info" /></span>
              <h2>Cómo se reparte</h2>
            </header>
            <ul class="rules-list">
              <li>
                <Icon name="repeat" />
                <div><strong id="rule-weekly-title">Semanas alternas</strong><p id="rule-weekly-text"></p></div>
              </li>
              <li class="sun-rule" data-legend="summer">
                <Icon name="sun" />
                <div><strong>Verano por periodos</strong><p id="rule-summer-text"></p></div>
              </li>
              <li>
                <Icon name="book-open" />
                <div><strong>Vacaciones escolares</strong><p id="rule-school-text"></p></div>
              </li>
            </ul>
          </article>
        </section>

        <section id="school-card" class="school-card card" aria-labelledby="school-card-title">
          <div class="school-card-intro">
            <span class="card-icon school-card-icon"><Icon name="book-open" /></span>
            <div>
              <p class="overline">Calendario escolar</p>
              <h2 id="school-card-title"></h2>
              <p id="school-card-text" class="school-card-text"></p>
            </div>
          </div>
          <ul id="school-card-items" class="school-items"></ul>
          <button id="open-school" class="button school-card-action" type="button"></button>
        </section>

        <section class="year-section" aria-labelledby="year-title">
          <div class="year-toolbar">
            <div>
              <h2 id="year-title"></h2>
              <p id="year-meta"></p>
            </div>
            <div class="year-controls">
              <button id="current-year" class="button button-secondary" type="button">Hoy</button>
              <div class="year-switch" role="group" aria-label="Cambiar de año">
                <button id="previous-year" type="button" aria-label="Año anterior">
                  <Icon name="chevron-left" size={20} />
                </button>
                <span id="active-year" aria-live="polite"></span>
                <button id="next-year" type="button" aria-label="Año siguiente">
                  <Icon name="chevron-right" size={20} />
                </button>
              </div>
            </div>
          </div>
          <ul class="legend" aria-label="Leyenda">
            <li><span class="legend-swatch is-father"></span><span data-person-name="father">Papá</span></li>
            <li><span class="legend-swatch is-mother"></span><span data-person-name="mother">Mamá</span></li>
            <li><span class="legend-swatch legend-swatch-change"></span>Día de cambio</li>
            <li data-legend="summer"><span class="legend-swatch legend-swatch-summer"></span>Verano</li>
            <li data-legend="holiday"><span class="legend-swatch legend-swatch-holiday"></span>Vacaciones escolares</li>
            <li data-legend="non-school">
              <span class="legend-swatch legend-swatch-non-school"></span>Festivo o puente
            </li>
            <li><span class="legend-swatch legend-swatch-today"></span>Hoy</li>
          </ul>
          <div id="calendar-years" class="months-grid"></div>
        </section>

        <section class="mini-year card" aria-labelledby="mini-year-title">
          <div class="mini-year-header">
            <h2 id="mini-year-title"><span id="mini-year-label"></span> de un vistazo</h2>
            <p>Toca un mes</p>
          </div>
          <div id="mini-year-grid" class="mini-year-grid"></div>
        </section>
      </main>

      <footer class="site-footer">
        <p><Icon name="lock" size={16} />Tus datos se guardan solo en este navegador. Nadie más puede verlos.</p>
        <p>Turnos · calendario de custodia compartida</p>
      </footer>
    </div>

    <dialog id="day-dialog" class="day-dialog" aria-labelledby="day-title">
      <div id="day-sheet" class="day-sheet">
        <header class="day-header">
          <span class="sheet-handle" aria-hidden="true"></span>
          <p id="day-weekday" class="day-weekday"></p>
          <h2 id="day-title" class="day-title"><span id="day-number"></span><span id="day-month"></span></h2>
          <button id="close-day" class="icon-button day-close" type="button" aria-label="Cerrar">
            <Icon name="x" size={20} />
          </button>
        </header>
        <div class="day-body">
          <div class="day-who">
            <span id="day-avatar" class="avatar" aria-hidden="true"></span>
            <div>
              <p class="day-who-label">Le toca a</p>
              <p id="day-name" class="day-name"></p>
              <p id="day-since" class="day-since"></p>
            </div>
          </div>
          <div id="day-handover" class="info-box">
            <span class="avatar-flow" aria-hidden="true">
              <span id="day-from" class="avatar avatar-xs"></span>
              <Icon name="arrow-right" size={16} />
              <span id="day-to" class="avatar avatar-xs"></span>
            </span>
            <div>
              <p id="day-change-title" class="info-title"></p>
              <p id="day-change-text"></p>
            </div>
          </div>
          <div id="day-visit" class="info-box info-box-warm">
            <span id="day-visit-avatar" class="avatar avatar-xs" aria-hidden="true"></span>
            <div>
              <p class="info-title"><Icon name="crown" size={16} />Visita de Reyes</p>
              <p id="day-visit-text"></p>
            </div>
          </div>
          <ul id="day-tags" class="tags" aria-label="Etiquetas del día"></ul>
          <p class="day-note"><Icon name="info" /><span id="day-note"></span></p>
        </div>
        <footer class="day-footer">
          <button id="previous-day" class="button button-secondary" type="button">
            <Icon name="chevron-left" />Día anterior
          </button>
          <button id="next-day" class="button button-secondary" type="button">
            Día siguiente<Icon name="chevron-right" />
          </button>
        </footer>
      </div>
    </dialog>

    <dialog id="config-dialog" class="config-dialog" aria-labelledby="config-title">
      <form id="config-form" class="config-shell" method="dialog" novalidate>
        <aside class="config-rail">
          <p class="brand brand-small" aria-hidden="true"><span class="brand-mark"></span><span>Turnos</span></p>
          <div class="config-rail-title">
            <p class="overline">Configuración</p>
            <h2 id="config-title">Tu calendario,<br />tus reglas.</h2>
          </div>
          <ol class="rail-steps" aria-label="Pasos de configuración">
            {
              steps.map((step, index) => (
                <li>
                  <button class="rail-step" type="button" data-progress-step={index}>
                    <span class="rail-step-dot">
                      <span class="rail-step-number">{index + 1}</span>
                      <span class="rail-step-check">
                        <Icon name="check" size={16} />
                      </span>
                    </span>
                    <span class="rail-step-text">
                      <strong>{step.label}</strong>
                      <span>{step.description}</span>
                    </span>
                  </button>
                </li>
              ))
            }
          </ol>
          <p class="rail-privacy">
            <Icon name="lock" />Se guarda solo en este navegador. No enviamos tus datos a ningún servidor.
          </p>
        </aside>

        <section class="config-main">
          <header class="config-header">
            <span class="sheet-handle" aria-hidden="true"></span>
            <button id="close-config" class="icon-button config-close" type="button" aria-label="Cerrar configuración">
              <Icon name="x" size={20} />
            </button>
            <div class="config-heading">
              <p class="config-mobile-title">Configuración</p>
              <p id="config-step-label" aria-live="polite"></p>
            </div>
            <button class="icon-button config-reset-mobile" type="button" aria-label="Restablecer" data-reset-config>
              <Icon name="rotate-ccw" size={19} />
            </button>
            <div class="config-progress" aria-hidden="true">
              {steps.map(() => <span data-progress-bar />)}
            </div>
          </header>

          <div id="config-body" class="config-body">
            <section class="config-step" data-config-step="0" aria-labelledby="step-title-0">
              <div class="step-heading">
                <h3 id="step-title-0">¿Cómo llamamos a cada turno?</h3>
                <p>Elige un nombre y un color para cada persona. Los verás en todo el calendario.</p>
              </div>
              <label class="field">
                <span class="field-label">Nombre del calendario</span>
                <input
                  id="config-title-input"
                  class="input"
                  name="title"
                  type="text"
                  maxlength="50"
                  placeholder="Custodia compartida"
                />
                <span class="field-hint">Aparece como título en la portada.</span>
              </label>
              <div class="person-grid">
                {
                  people.map((person) => (
                    <fieldset class:list={['person-card', `is-${person.id}`]}>
                      <legend class="visually-hidden">{person.title}</legend>
                      <div class="person-card-header">
                        <span class="avatar avatar-md" data-person-avatar={person.id} aria-hidden="true">
                          {person.initial}
                        </span>
                        <span>
                          <span class="overline">{person.title}</span>
                          <strong>{person.turn}</strong>
                        </span>
                      </div>
                      <label class="field">
                        <span class="field-label">Nombre</span>
                        <input
                          id={`${person.id}-name`}
                          class="input"
                          name={`${person.id}Name`}
                          type="text"
                          maxlength="24"
                          required
                        />
                      </label>
                      <div class="field">
                        <span id={`${person.id}-color-label`} class="field-label">
                          Color en el calendario
                        </span>
                        <div class="swatches" role="group" aria-labelledby={`${person.id}-color-label`}>
                          {person.swatches.map((swatch) => (
                            <button
                              class="swatch-option"
                              type="button"
                              aria-label={swatch.name}
                              aria-pressed="false"
                              data-swatch={person.id}
                              data-color={swatch.color}
                              style={`--swatch: ${swatch.color}`}
                            />
                          ))}
                          <label class="swatch-option swatch-custom" title="Elegir otro color">
                            <input
                              id={`${person.id}-color`}
                              name={`${person.id}Color`}
                              type="color"
                              aria-label={`Elegir otro color para ${person.title}`}
                            />
                            <Icon name="plus" />
                          </label>
                        </div>
                      </div>
                    </fieldset>
                  ))
                }
              </div>
              <div class="preview-card" aria-hidden="true">
                <p class="preview-title">Vista previa</p>
                <div class="weekdays">{weekdayLabels.map((label) => <span>{label}</span>)}</div>
                <div class="preview-weeks">
                  <div class="preview-week is-father">{weekdayLabels.map(() => <span data-preview-day />)}</div>
                  <div class="preview-week is-mother">{weekdayLabels.map(() => <span data-preview-day />)}</div>
                </div>
              </div>
              <label class="field">
                <span class="field-label">Zona horaria</span>
                <span class="input-icon">
                  <Icon name="globe" />
                  <input
                    id="config-timezone"
                    class="input"
                    name="timezone"
                    type="text"
                    list="timezone-options"
                    required
                  />
                </span>
                <datalist id="timezone-options">
                  <option value="Europe/Madrid"></option>
                  <option value="Atlantic/Canary"></option>
                  <option value="Europe/London"></option>
                  <option value="America/Mexico_City"></option>
                  <option value="America/Argentina/Buenos_Aires"></option>
                  <option value="UTC"></option>
                </datalist>
                <span class="field-hint">Se usa para calcular las horas de cambio.</span>
              </label>
            </section>

            <section class="config-step" data-config-step="1" aria-labelledby="step-title-1" hidden>
              <div class="step-heading">
                <h3 id="step-title-1">Define el ritmo semanal.</h3>
                <p>¿Cada cuánto cambia el turno y a qué hora? Podrás ajustarlo cuando quieras.</p>
              </div>
              <div class="form-row">
                <label class="field">
                  <span class="field-label">Fecha de inicio</span>
                  <input id="schedule-start-date" class="input" name="startDate" type="date" required />
                  <span class="field-hint">El primer día del calendario.</span>
                </label>
                <fieldset class="field">
                  <legend class="field-label">Empieza</legend>
                  <div class="segmented">
                    <label>
                      <input type="radio" name="startsWith" value="father" required />
                      <span><i class="person-dot is-father"></i><span data-form-person-name="father">Papá</span></span>
                    </label>
                    <label>
                      <input type="radio" name="startsWith" value="mother" />
                      <span><i class="person-dot is-mother"></i><span data-form-person-name="mother">Mamá</span></span>
                    </label>
                  </div>
                </fieldset>
              </div>
              <fieldset class="field">
                <legend class="field-label">Día de cambio</legend>
                <div class="weekday-picker">
                  {
                    weekdayOptions.map((weekday, index) => (
                      <label>
                        <input
                          type="radio"
                          name="exchangeWeekday"
                          value={weekday.value}
                          aria-label={weekday.name}
                          required={index === 0}
                        />
                        <span aria-hidden="true">{weekday.label}</span>
                      </label>
                    ))
                  }
                </div>
              </fieldset>
              <div class="form-row">
                <label class="field">
                  <span class="field-label">Hora de cambio</span>
                  <input id="exchange-time" class="input" name="exchangeTime" type="time" required />
                </label>
                <div class="field">
                  <label class="field-label" for="turn-weeks">Duración del turno</label>
                  <div class="stepper">
                    <button type="button" aria-label="Menos semanas" data-turn-step="-1"><Icon name="minus" /></button>
                    <span class="stepper-value">
                      <input id="turn-weeks" name="turnWeeks" type="number" min="1" max="8" required />
                      <span id="turn-weeks-unit">semana</span>
                    </span>
                    <button type="button" aria-label="Más semanas" data-turn-step="1"><Icon name="plus" /></button>
                  </div>
                </div>
              </div>
              <fieldset class="field">
                <legend class="field-label">Rotación</legend>
                <div class="choice-grid">
                  <label class="choice-card">
                    <input type="radio" name="rotation" value="annual" required />
                    <span class="choice-radio"></span>
                    <span class="choice-text">
                      <strong>Anual</strong><span>La semana 1 cambia de persona cada año.</span>
                    </span>
                  </label>
                  <label class="choice-card">
                    <input type="radio" name="rotation" value="continuous" />
                    <span class="choice-radio"></span>
                    <span class="choice-text">
                      <strong>Continua</strong><span>Alterna sin pausa desde la fecha de inicio.</span>
                    </span>
                  </label>
                </div>
              </fieldset>
              <fieldset class="field">
                <legend class="field-label">Años con 53 semanas</legend>
                <div class="choice-grid">
                  <label class="choice-card">
                    <input type="radio" name="week53Strategy" value="continue" required />
                    <span class="choice-radio"></span>
                    <span class="choice-text">
                      <strong>Continúa la alternancia</strong><span>La semana 53 sigue el ritmo normal.</span>
                    </span>
                  </label>
                  <label class="choice-card">
                    <input type="radio" name="week53Strategy" value="same-as-52" />
                    <span class="choice-radio"></span>
                    <span class="choice-text">
                      <strong>Igual que la semana 52</strong><span>Mantiene a la misma persona.</span>
                    </span>
                  </label>
                </div>
              </fieldset>
            </section>

            <section class="config-step" data-config-step="2" aria-labelledby="step-title-2" hidden>
              <div class="step-heading">
                <h3 id="step-title-2">Configura el verano.</h3>
                <p>En verano el calendario se reparte por periodos en lugar de semanas.</p>
              </div>
              <label class="toggle-card">
                <span class="toggle-icon"><Icon name="sun" size={20} /></span>
                <span class="toggle-text">
                  <strong>Régimen especial en verano</strong>
                  <span>Sustituye el turno semanal durante los meses elegidos.</span>
                </span>
                <input id="summer-enabled" name="summerEnabled" type="checkbox" role="switch" />
                <span class="switch" aria-hidden="true"></span>
              </label>
              <fieldset id="summer-fields" class="summer-fields">
                <legend class="visually-hidden">Opciones de verano</legend>
                <div class="form-row">
                  <label class="field">
                    <span class="field-label">Primer mes</span>
                    <span class="select-wrap">
                      <select id="summer-start-month" class="input" name="summerStartMonth">
                        {months.map((month, index) => <option value={index + 1}>{month}</option>)}
                      </select>
                      <Icon name="chevron-down" />
                    </span>
                  </label>
                  <label class="field">
                    <span class="field-label">Último mes</span>
                    <span class="select-wrap">
                      <select id="summer-end-month" class="input" name="summerEndMonth">
                        {months.map((month, index) => <option value={index + 1}>{month}</option>)}
                      </select>
                      <Icon name="chevron-down" />
                    </span>
                  </label>
                </div>
                <div class="field">
                  <span id="split-days-label" class="field-label"
                    >Cada mes se divide en periodos que empiezan el día…</span
                  >
                  <div class="chip-row">
                    <ul id="summer-split-list" class="chips" aria-labelledby="split-days-label"></ul>
                    <span class="chip-add">
                      <input
                        id="summer-split-new"
                        type="number"
                        min="2"
                        max="31"
                        placeholder="Día"
                        aria-label="Nuevo día de inicio de periodo"
                      />
                      <button id="add-summer-split" type="button"><Icon name="plus" size={16} />Añadir día</button>
                    </span>
                  </div>
                  <input id="summer-split-days" name="summerSplitDays" type="hidden" />
                </div>
                <div class="form-row">
                  <label class="field">
                    <span class="field-label">Hora de cambio</span>
                    <input id="summer-exchange-time" class="input" name="summerExchangeTime" type="time" required />
                  </label>
                  <fieldset class="field">
                    <legend class="field-label">En años pares empieza</legend>
                    <div class="segmented">
                      <label>
                        <input type="radio" name="summerEvenStartsWith" value="father" required />
                        <span><i class="person-dot is-father"></i><span data-form-person-name="father">Papá</span></span
                        >
                      </label>
                      <label>
                        <input type="radio" name="summerEvenStartsWith" value="mother" />
                        <span><i class="person-dot is-mother"></i><span data-form-person-name="mother">Mamá</span></span
                        >
                      </label>
                    </div>
                  </fieldset>
                </div>
                <label class="field">
                  <span class="field-label">Al terminar el verano</span>
                  <span class="select-wrap">
                    <select id="summer-resume-strategy" class="input" name="summerResumeStrategy">
                      <option value="opposite-last-period"
                        >Sigue quien no tuvo el último periodo, hasta el cambio</option
                      >
                      <option value="preserve">Se recupera el calendario semanal</option>
                      <option value="restart">Se reinicia la alternancia</option>
                    </select>
                    <Icon name="chevron-down" />
                  </span>
                </label>
                <div class="preview-card">
                  <p id="summer-preview-title" class="preview-title"></p>
                  <div id="summer-preview" class="summer-preview"></div>
                  <p id="summer-preview-note" class="field-hint"></p>
                </div>
              </fieldset>
            </section>

            <section class="config-step" data-config-step="3" aria-labelledby="step-title-3" hidden>
              <div class="step-heading">
                <h3 id="step-title-3">Comprueba las reglas.</h3>
                <p>Así funcionará tu calendario. Puedes volver a cualquier paso para cambiarlo.</p>
              </div>
              <div id="config-summary" class="summary-grid"></div>
              <p class="rule-note">
                <Icon name="book-open" />Las vacaciones y los festivos cambian cada curso, así que se apuntan aparte
                desde «Calendario escolar», en la portada.
              </p>
              <div class="privacy-callout">
                <span class="card-icon card-icon-white"><Icon name="lock" /></span>
                <p>
                  <strong>Tus datos se quedan aquí</strong>
                  La configuración se guarda solo en este navegador (<span id="summary-timezone">Europe/Madrid</span>).
                  Si borras los datos del navegador, también se borrará el calendario.
                </p>
              </div>
            </section>
          </div>

          <p id="config-error" class="config-error" role="alert" hidden></p>
          <footer class="config-footer">
            <button class="button button-text" type="button" data-reset-config>
              <Icon name="rotate-ccw" />Restablecer
            </button>
            <span class="config-footer-spacer"></span>
            <button id="previous-step" class="button button-secondary" type="button" hidden>
              <Icon name="chevron-left" />Anterior
            </button>
            <button id="next-step" class="button button-primary" type="button">
              Siguiente<Icon name="arrow-right" />
            </button>
            <button id="save-config" class="button button-primary" type="submit" hidden>
              <Icon name="check" />Guardar calendario
            </button>
          </footer>
        </section>
      </form>
    </dialog>

    <dialog id="school-dialog" class="school-dialog" aria-labelledby="school-title">
      <form id="school-form" class="school-shell" method="dialog" novalidate>
        <header class="school-header">
          <span class="sheet-handle" aria-hidden="true"></span>
          <span class="card-icon school-header-icon"><Icon name="book-open" size={20} /></span>
          <div class="school-heading">
            <p class="overline">Calendario escolar</p>
            <h2 id="school-title">Vacaciones y festivos</h2>
            <p>
              Cambian cada curso: apúntalos cuando el colegio publique su calendario. Solo necesitas el último día de
              clase y el día de vuelta; el día de cambio lo calculamos por ti.
            </p>
          </div>
          <button id="close-school" class="icon-button config-close" type="button" aria-label="Cerrar">
            <Icon name="x" size={20} />
          </button>
        </header>

        <div id="school-body" class="school-body">
          <section class="rule-panel" aria-labelledby="vacations-title">
            <header class="rule-panel-header">
              <div class="rule-panel-title">
                <span class="card-icon card-icon-outline"><Icon name="book-open" /></span>
                <div>
                  <h3 id="vacations-title">Vacaciones escolares</h3>
                  <p>Añade un curso cada año. Los anteriores se conservan.</p>
                </div>
              </div>
              <div class="course-adder">
                <label class="field field-compact">
                  <span class="field-label">Curso que empieza en</span>
                  <span class="year-input">
                    <input id="school-year-start" type="number" min="2000" max="2100" step="1" required />
                    <span id="school-year-preview">/ 27</span>
                  </span>
                </label>
                <button id="add-school-year" class="button button-primary button-square" type="button">
                  <Icon name="plus" size={16} />Añadir curso
                </button>
              </div>
            </header>
            <div id="vacation-period-list" class="rule-list"></div>
          </section>
          <section class="rule-panel" aria-labelledby="non-school-title">
            <header class="rule-panel-header">
              <div class="rule-panel-title">
                <span class="card-icon card-icon-outline"><Icon name="calendar" /></span>
                <div>
                  <h3 id="non-school-title">Festivos y puentes</h3>
                  <p>Indica el intervalo no lectivo completo.</p>
                </div>
              </div>
              <button id="add-non-school" class="button button-secondary button-square" type="button">
                <Icon name="plus" size={16} />Añadir festivo
              </button>
            </header>
            <div class="rule-list">
              <div id="non-school-period-list" class="non-school-list"></div>
              <p class="rule-note">
                <Icon name="info" />Si un festivo cae en el día de cambio, el cambio se retrasa a las 09:00 del primer
                día posterior.
              </p>
            </div>
          </section>
        </div>

        <p id="school-error" class="config-error" role="alert" hidden></p>
        <footer class="config-footer school-footer">
          <p class="school-footer-note"><Icon name="lock" size={16} />Se guarda solo en este navegador.</p>
          <span class="config-footer-spacer"></span>
          <button id="cancel-school" class="button button-secondary" type="button">Cancelar</button>
          <button id="save-school" class="button button-primary" type="submit">
            <Icon name="check" />Guardar fechas
          </button>
        </footer>
      </form>
    </dialog>

    <script src="../scripts/custody-calendar.ts"></script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f3f5fa;
    --surface: #ffffff;
    --surface-soft: #f7f8fc;
    --surface-muted: #fbfcfe;
    --tint: #eef1fa;
    --muted: #eef1f6;
    --rail: #eef2fa;
    --line: #e2e6f0;
    --line-strong: #d6dbe7;
    --pending: #c3cadb;
    --dashed: #b4bbcd;
    --ink: #1d2340;
    --ink-hover: #2b3360;
    --ink-2: #4b5272;
    --ink-3: #626986;
    --papa: #a9cbf4;
    --papa-soft: #d8e8fb;
    --mama: #ffd3b6;
    --mama-soft: #ffebde;
    --sun: #e9a93a;
    --sun-soft: #fff2cc;
    --sun-ink: #7a5200;
    --sun-icon: #9a6a00;
    --warm-soft: #fff6de;
    --warm-line: #f3dfa6;
    --warm-ink: #5c4410;
    --danger: #a8321f;
    --danger-soft: #fcedea;
    --empty-day: #e6eaf2;
    --scrim: rgb(22 27 52 / 48%);
    --focus: rgb(29 35 64 / 35%);
    --font: 'Nunito', ui-rounded, 'Segoe UI', system-ui, sans-serif;
    --shadow-soft: 0 1px 2px rgb(29 35 64 / 4%);
    --shadow-float: 0 1px 2px rgb(29 35 64 / 4%), 0 28px 56px -36px rgb(29 35 64 / 38%);
    --shadow-dialog: 0 2px 6px rgb(15 20 45 / 8%), 0 40px 100px -40px rgb(15 20 45 / 55%);
    color-scheme: light;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    -webkit-text-size-adjust: 100%;
  }

  body {
    min-height: 100vh;
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font);
    font-size: 16px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3,
  h4,
  p {
    margin: 0;
  }

  button,
  input,
  select {
    font: inherit;
    color: inherit;
  }

  button {
    cursor: pointer;
  }

  button:disabled {
    cursor: not-allowed;
  }

  code {
    font-family: inherit;
    font-weight: 700;
  }

  .icon {
    display: block;
    flex: none;
  }

  [hidden] {
    display: none !important;
  }

  :focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .is-father {
    --person: var(--papa);
    --person-soft: var(--papa-soft);
  }

  .is-mother {
    --person: var(--mama);
    --person-soft: var(--mama-soft);
  }

  /* Estructura */
  .page {
    display: flex;
    flex-direction: column;
    gap: 28px;
    width: min(1280px, calc(100% - 2 * clamp(16px, 5vw, 80px)));
    margin: 0 auto;
    padding-bottom: 48px;
  }

  .dashboard {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 24px;
  }

  .overline {
    color: var(--ink-3);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Botones */
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 48px;
    padding: 0 20px;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 800;
    white-space: nowrap;
    transition:
      background-color 0.15s,
      border-color 0.15s,
      transform 0.15s;
  }

  .button:active:not(:disabled) {
    transform: translateY(1px);
  }

  .button:disabled {
    opacity: 0.5;
  }

  .button-primary {
    background: var(--ink);
    color: #ffffff;
  }

  .button-primary:hover:not(:disabled) {
    background: var(--ink-hover);
  }

  .button-secondary {
    border-color: var(--line-strong);
    background: var(--surface);
    color: var(--ink);
  }

  .button-secondary:hover:not(:disabled) {
    background: var(--surface-soft);
  }

  .button-text {
    padding: 0 12px;
    background: transparent;
    color: var(--ink-2);
  }

  .button-text:hover {
    background: var(--muted);
    color: var(--ink);
  }

  .button-square {
    border-radius: 14px;
  }

  .icon-button {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    transition: background-color 0.15s;
  }

  .icon-button:hover:not(:disabled) {
    background: var(--surface-soft);
  }

  .icon-button:disabled {
    color: var(--line-strong);
  }

  .icon-button-danger {
    border-color: transparent;
    background: var(--danger-soft);
    color: var(--danger);
  }

  .icon-button-danger:hover:not(:disabled) {
    background: #f8ded9;
  }

  .icon-button-square {
    width: 46px;
    height: 46px;
    border-radius: 12px;
  }

  /* Cabecera */
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 22px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--ink);
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .brand-mark {
    position: relative;
    flex: none;
    width: 36px;
    height: 36px;
  }

  .brand-mark::before,
  .brand-mark::after {
    content: '';
    position: absolute;
    top: 7px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
  }

  .brand-mark::before {
    left: 3px;
    background: var(--papa);
  }

  .brand-mark::after {
    left: 11px;
    background: var(--mama);
    opacity: 0.85;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .privacy-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-2);
    font-size: 14px;
    font-weight: 600;
  }

  .header-today {
    display: none;
  }

  .config-trigger {
    height: 44px;
    padding: 0 22px;
  }

  /* Portada */
  .hero {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    align-items: center;
    gap: 28px;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding: 8px 0;
  }

  .eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px 8px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-2);
    font-size: 14px;
    font-weight: 700;
  }

  .hero h1 {
    font-size: clamp(40px, 5vw, 66px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.04;
  }

  .underline {
    background-image: linear-gradient(90deg, var(--papa) 0 50%, var(--mama) 50% 100%);
    background-position: 0 90%;
    background-repeat: no-repeat;
    background-size: 100% 0.32em;
    white-space: nowrap;
  }

  .hero-lead {
    max-width: 520px;
    color: var(--ink-2);
    font-size: 18px;
    line-height: 1.6;
  }

  .now-card {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 28px;
    background: var(--surface);
    box-shadow: var(--shadow-float);
  }

  .now-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .now-live {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink-2);
    font-size: 13px;
    font-weight: 700;
  }

  .now-live::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink);
  }

  .now-who {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .now-label {
    color: var(--ink-2);
    font-size: 16px;
    font-weight: 600;
  }

  .now-name {
    font-size: 40px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .now-progress {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .now-progress-text {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--ink-2);
    font-size: 14px;
    font-weight: 700;
  }

  .segments {
    display: flex;
    gap: 5px;
  }

  .segments span {
    flex: 1;
    height: 10px;
    border-radius: 999px;
    background: var(--empty-day);
  }

  .segments .is-past {
    background: var(--person);
  }

  .segments .is-current {
    background: var(--ink);
  }

  .now-card[data-state='pending'] .now-progress,
  .now-card[data-state='pending'] .now-live,
  .now-card[data-state='pending'] .next-change {
    display: none;
  }

  .next-change {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 16px 16px 16px 18px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--surface-soft);
    color: var(--ink);
    text-align: left;
    transition: border-color 0.15s;
  }

  .next-change:hover {
    border-color: var(--line-strong);
  }

  .next-change-text {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .next-change-label {
    color: var(--ink-3);
    font-size: 13px;
    font-weight: 800;
  }

  .next-change-text strong {
    font-size: 18px;
    font-weight: 800;
  }

  #next-sub {
    color: var(--ink-2);
    font-size: 14px;
    font-weight: 600;
  }

  .next-change-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--surface);
  }

  /* Avatares */
  .avatar {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--person, var(--muted));
    color: var(--ink);
    font-size: 24px;
    font-weight: 800;
    line-height: 1;
  }

  .avatar-lg {
    width: 72px;
    height: 72px;
    font-size: 30px;
  }

  .avatar-md {
    width: 52px;
    height: 52px;
    font-size: 22px;
  }

  .avatar-sm {
    width: 38px;
    height: 38px;
    font-size: 15px;
  }

  .avatar-xs {
    width: 34px;
    height: 34px;
    font-size: 14px;
  }

  .avatar-pair {
    display: flex;
    flex: none;
  }

  .avatar-pair .avatar {
    box-shadow: 0 0 0 3px var(--surface-soft);
  }

  .avatar-pair .avatar + .avatar {
    margin-left: -8px;
  }

  .person-dot {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--person);
  }

  /* Resumen */
  .overview {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    align-items: start;
    gap: 20px;
  }

  .overview .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 22px;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .card-header h2 {
    font-size: 18px;
    font-weight: 800;
  }

  .card-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background: var(--tint);
    color: var(--ink);
  }

  .card-icon-outline {
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .card-icon-white {
    width: 40px;
    height: 40px;
    background: var(--surface);
  }

  .upcoming-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .upcoming-list li:nth-child(4) {
    display: none;
  }

  .upcoming-item {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 8px;
    border: 0;
    border-radius: 16px;
    background: transparent;
    color: var(--ink);
    text-align: left;
    transition: background-color 0.15s;
  }

  .upcoming-item:hover {
    background: var(--surface-soft);
  }

  .upcoming-date {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    width: 54px;
    height: 54px;
    border-radius: 16px;
    background: var(--person-soft);
    line-height: 1;
  }

  .upcoming-date strong {
    font-size: 20px;
    font-weight: 800;
  }

  .upcoming-date span {
    color: var(--ink-2);
    font-size: 12px;
    font-weight: 800;
  }

  .upcoming-text {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .upcoming-when {
    font-size: 15px;
    font-weight: 800;
  }

  .upcoming-flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    color: var(--ink-2);
    font-size: 14px;
    font-weight: 600;
  }

  .upcoming-reason {
    color: var(--ink-3);
    font-size: 13px;
    font-weight: 600;
  }

  .upcoming-empty {
    padding: 8px;
    color: var(--ink-3);
    font-size: 14px;
    font-weight: 600;
  }

  .share-numbers {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
  }

  .share-numbers > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .share-numbers > div:last-child {
    align-items: flex-end;
  }

  .share-person {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ink-2);
    font-size: 14px;
    font-weight: 700;
  }

  .share-swatch {
    width: 12px;
    height: 12px;
    border-radius: 4px;
    background: var(--person);
  }

  .share-value {
    color: var(--ink-3);
    font-size: 15px;
    font-weight: 700;
  }

  .share-value strong {
    color: var(--ink);
    font-size: 34px;
    font-variant-numeric: tabular-nums;
    font-weight: 800;
    line-height: 1.1;
  }

  .share-bar {
    display: flex;
    gap: 4px;
    height: 14px;
  }

  .share-bar span {
    flex: 1;
    border-radius: 999px;
    background: var(--mama);
  }

  .share-bar span:first-child {
    flex: none;
    width: var(--share, 50%);
    background: var(--papa);
  }

  .share-percent {
    display: flex;
    justify-content: space-between;
    color: var(--ink-2);
    font-size: 14px;
    font-weight: 700;
  }

  .card-note {
    color: var(--ink-3);
    font-size: 13px;
    line-height: 1.5;
  }

  .rules-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rules-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.5;
  }

  .rules-list .icon {
    margin-top: 2px;
  }

  .rules-list .sun-rule .icon {
    color: var(--sun-icon);
  }

  .rules-list strong {
    display: block;
    color: var(--ink);
    font-size: 15px;
  }

  /* Calendario escolar en la portada */
  .school-card {
    display: grid;
    grid-template-areas: 'intro items action';
    grid-template-columns: minmax(240px, 300px) minmax(0, 1fr) auto;
    align-items: center;
    gap: 18px 28px;
    padding: 22px 24px;
  }

  .school-card-intro {
    display: flex;
    grid-area: intro;
    align-items: flex-start;
    gap: 14px;
  }

  .school-card-intro h2 {
    margin-top: 2px;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .school-card-text {
    margin-top: 4px;
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.5;
  }

  .school-items {
    display: grid;
    grid-area: items;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .school-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    padding: 12px 16px;
    border-radius: 16px;
    background: var(--surface-soft);
  }

  .school-item-label {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 2px;
    color: var(--ink-2);
    font-size: 13px;
    font-weight: 800;
  }

  .school-item-label .legend-swatch {
    width: 16px;
    height: 16px;
    border-radius: 5px;
  }

  .school-item strong {
    font-size: 16px;
    font-weight: 800;
  }

  .school-item-sub {
    color: var(--ink-3);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
  }

  .school-item.is-empty {
    border: 1.5px dashed var(--line-strong);
    background: transparent;
  }

  .school-item.is-empty strong {
    color: var(--ink-3);
  }

  .school-card-action {
    grid-area: action;
  }

  .school-card.is-missing {
    grid-template-areas: 'intro action';
    grid-template-columns: minmax(0, 1fr) auto;
    border-color: var(--warm-line);
    background: var(--warm-soft);
  }

  .school-card.is-missing .school-card-icon {
    background: var(--sun-soft);
    color: var(--sun-icon);
  }

  .school-card.is-missing .school-card-text {
    max-width: 640px;
    color: var(--warm-ink);
  }

  @media (max-width: 1100px) {
    .school-card {
      grid-template-areas:
        'intro action'
        'items items';
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  /* Año */
  .year-section {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-top: 8px;
  }

  .year-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
  }

  #year-title {
    font-size: 52px;
    font-variant-numeric: tabular-nums;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  #year-meta {
    margin-top: 6px;
    color: var(--ink-2);
    font-size: 15px;
    font-weight: 700;
  }

  .year-controls {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .year-switch {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--surface);
  }

  .year-switch button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
  }

  .year-switch button:hover:not(:disabled) {
    background: var(--muted);
  }

  .year-switch button:disabled {
    color: var(--line-strong);
  }

  #active-year {
    min-width: 60px;
    font-size: 16px;
    font-variant-numeric: tabular-nums;
    font-weight: 800;
    text-align: center;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 14px 0 9px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 14px;
    font-weight: 700;
  }

  .legend-swatch {
    position: relative;
    flex: none;
    width: 20px;
    height: 20px;
    overflow: hidden;
    border-radius: 7px;
    background: var(--person, var(--empty-day));
  }

  .legend-swatch-change {
    background: linear-gradient(135deg, var(--papa) 50%, var(--mama) 50%);
  }

  .legend-swatch-summer {
    box-shadow: inset 0 -4px 0 var(--sun);
  }

  .legend-swatch-holiday::after {
    content: '';
    position: absolute;
    bottom: 3px;
    left: 50%;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--ink);
  }

  .legend-swatch-non-school {
    background: repeating-linear-gradient(135deg, rgb(29 35 64 / 24%) 0 2px, transparent 2px 6px), var(--empty-day);
  }

  .legend-swatch-today {
    width: 16px;
    height: 16px;
    margin: 0 2px;
    border-radius: 6px;
    background: var(--surface);
    box-shadow: inset 0 0 0 2px var(--ink);
  }

  .months-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 272px), 1fr));
    gap: 20px;
  }

  .month {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px 14px 16px;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--surface);
    box-shadow: var(--shadow-soft);
    animation: rise 0.4s ease-out both;
  }

  .month.is-current {
    border-color: var(--ink);
    box-shadow:
      0 0 0 1px var(--ink),
      0 20px 40px -28px rgb(29 35 64 / 45%);
  }

  .month-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 28px;
    padding: 0 6px;
  }

  .month-header h3 {
    font-size: 18px;
    font-weight: 800;
  }

  .month-number {
    color: var(--ink-3);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    font-weight: 800;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 26px;
    padding: 0 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 800;
  }

  .badge-summer {
    background: var(--sun-soft);
    color: var(--sun-ink);
  }

  .badge-current {
    background: var(--ink);
    color: #ffffff;
  }

  .weekdays {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    color: var(--ink-3);
    font-size: 12px;
    font-weight: 800;
    text-align: center;
  }

  /* Columna de números de semana + días del mes. */
  .month-grid {
    --day-height: 36px;
    --day-radius: 10px;
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr);
    gap: 10px 4px;
  }

  .week-corner,
  .weekdays span {
    display: grid;
    place-items: center;
    height: 24px;
  }

  .week-corner {
    color: var(--ink-3);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .week-numbers {
    display: grid;
    grid-auto-rows: var(--day-height);
    row-gap: 6px;
  }

  .week-number {
    display: grid;
    place-items: center;
    color: var(--ink-3);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    font-weight: 800;
  }

  .week-number span {
    display: grid;
    place-items: center;
    min-width: 24px;
    height: 22px;
    padding: 0 4px;
    border-radius: 999px;
  }

  .week-number.is-current span {
    background: var(--ink);
    color: #ffffff;
  }

  .month-days {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    row-gap: 6px;
  }

  .day {
    position: relative;
    display: grid;
    place-items: center;
    height: var(--day-height);
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: var(--person, var(--empty-day));
    color: var(--ink);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    transition: filter 0.15s;
  }

  .day:hover:not(:disabled) {
    filter: brightness(0.95);
  }

  .day:focus-visible {
    z-index: 2;
  }

  .day.run-start {
    border-start-start-radius: var(--day-radius);
    border-end-start-radius: var(--day-radius);
  }

  .day.run-end {
    border-start-end-radius: var(--day-radius);
    border-end-end-radius: var(--day-radius);
  }

  .day.handover.from-father {
    background: linear-gradient(135deg, var(--papa) 50%, var(--person) 50%);
  }

  .day.handover.from-mother {
    background: linear-gradient(135deg, var(--mama) 50%, var(--person) 50%);
  }

  .day.non-school:not(.handover) {
    background: repeating-linear-gradient(135deg, rgb(29 35 64 / 16%) 0 2px, transparent 2px 7px), var(--person);
  }

  .day.summer {
    box-shadow: inset 0 -3px 0 var(--sun);
  }

  .day.holiday::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 50%;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--ink);
  }

  .day.today {
    z-index: 1;
    border-radius: var(--day-radius);
    box-shadow:
      0 0 0 2px var(--surface),
      0 0 0 4px var(--ink);
    font-weight: 800;
  }

  .day.today.summer {
    box-shadow:
      inset 0 -3px 0 var(--sun),
      0 0 0 2px var(--surface),
      0 0 0 4px var(--ink);
  }

  .day.inactive {
    border-radius: var(--day-radius);
    background: var(--muted);
    color: var(--ink-3);
    font-weight: 600;
  }

  .day-empty {
    height: var(--day-height);
  }

  /* Móvil: mes y año de un vistazo */
  .mobile-month,
  .mini-year {
    display: none;
  }

  .mobile-month {
    flex-direction: column;
    gap: 10px;
    padding: 14px 12px 16px;
  }

  .month-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    text-align: center;
  }

  .month-nav h2 {
    font-size: 20px;
    font-weight: 800;
  }

  .month-nav p {
    color: var(--ink-3);
    font-size: 13px;
    font-weight: 700;
  }

  .mobile-month .icon-button {
    border-color: var(--line);
  }

  .mobile-month .month-grid {
    --day-height: 44px;
    --day-radius: 12px;
    padding-top: 4px;
  }

  .mobile-month .day {
    font-size: 15px;
  }

  .legend-compact {
    gap: 8px 14px;
    margin-top: 6px;
    padding: 12px 4px 0;
    border-top: 1px solid var(--muted);
  }

  .legend-compact li {
    gap: 6px;
    height: auto;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-2);
    font-size: 13px;
  }

  .legend-compact .legend-swatch {
    width: 14px;
    height: 14px;
    border-radius: 5px;
  }

  .legend-compact .legend-swatch-today {
    margin: 0;
  }

  .legend-compact .legend-swatch-holiday::after {
    bottom: 2px;
  }

  .mini-year {
    flex-direction: column;
    gap: 14px;
    padding: 18px 14px 16px;
  }

  .mini-year-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    padding: 0 6px;
  }

  .mini-year-header h2 {
    font-size: 18px;
    font-weight: 800;
  }

  .mini-year-header p {
    color: var(--ink-3);
    font-size: 13px;
    font-weight: 700;
  }

  .mini-year-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .mini-month {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 8px 7px 9px;
    border: 0;
    border-radius: 14px;
    background: transparent;
    color: var(--ink);
    text-align: left;
  }

  .mini-month.is-active {
    background: var(--tint);
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }

  .mini-month-name {
    padding-left: 2px;
    font-size: 12px;
    font-weight: 800;
  }

  .mini-days {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 2px;
  }

  .mini-day {
    height: 11px;
    border-radius: 3px;
    background: var(--person, transparent);
  }

  .mini-day.inactive {
    background: var(--muted);
  }

  .mini-day.today {
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }

  /* Pie */
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    color: var(--ink-3);
    font-size: 14px;
    font-weight: 600;
  }

  .site-footer p {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  /* Diálogos */
  dialog {
    max-width: none;
    max-height: none;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
  }

  dialog::backdrop {
    background: var(--scrim);
  }

  dialog[open] {
    animation: dialog-in 0.22s ease-out;
  }

  .sheet-handle {
    display: none;
    width: 44px;
    height: 5px;
    border-radius: 999px;
    background: rgb(29 35 64 / 22%);
  }

  .day-dialog {
    width: min(440px, calc(100% - 32px));
    margin: auto;
  }

  .day-sheet {
    overflow: hidden;
    border-radius: 28px;
    background: var(--surface);
    box-shadow: var(--shadow-dialog);
  }

  .day-header {
    position: relative;
    padding: 22px 24px;
    background: var(--person-soft, var(--muted));
  }

  .day-header .sheet-handle {
    margin: -8px auto 14px;
  }

  .day-weekday {
    color: var(--ink-2);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .day-title {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 2px;
    font-weight: 800;
  }

  #day-number {
    font-size: 60px;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  #day-month {
    font-size: 20px;
  }

  .day-close {
    position: absolute;
    top: 16px;
    right: 16px;
    border: 0;
    box-shadow: 0 1px 2px rgb(29 35 64 / 8%);
  }

  .day-body {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 22px 24px 20px;
  }

  .day-who {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .day-who-label {
    color: var(--ink-3);
    font-size: 14px;
    font-weight: 700;
  }

  .day-name {
    font-size: 26px;
    font-weight: 800;
    line-height: 1.1;
  }

  .day-since {
    color: var(--ink-2);
    font-size: 15px;
    font-weight: 600;
  }

  .info-box {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--surface-soft);
  }

  .info-box > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .info-box p:not(.info-title) {
    color: var(--ink-2);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.45;
  }

  .info-box-warm {
    border-color: var(--warm-line);
    background: var(--warm-soft);
  }

  .info-box-warm p:not(.info-title) {
    color: var(--warm-ink);
  }

  .info-box-warm .icon {
    color: var(--sun-ink);
  }

  .info-title {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 16px;
    font-weight: 800;
  }

  .avatar-flow {
    display: flex;
    flex: none;
    align-items: center;
    gap: 6px;
    color: var(--ink-2);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 12px;
    border-radius: 999px;
    background: var(--tint);
    color: var(--ink-2);
    font-size: 13px;
    font-weight: 800;
  }

  .day-note {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.55;
  }

  .day-note .icon {
    margin-top: 2px;
  }

  .day-footer {
    display: flex;
    gap: 10px;
    padding: 14px 24px 16px;
    border-top: 1px solid var(--line);
  }

  .day-footer .button {
    flex: 1;
  }

  /* Configuración */
  .config-dialog {
    width: min(1040px, calc(100% - 48px));
    height: min(760px, calc(100dvh - 48px));
    margin: auto;
  }

  .config-shell {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    height: 100%;
    overflow: hidden;
    border-radius: 28px;
    background: var(--surface);
    box-shadow: var(--shadow-dialog);
  }

  .config-rail {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 30px 24px 24px;
    overflow-y: auto;
    background: var(--rail);
  }

  .brand-small {
    gap: 10px;
    padding: 0 4px;
    font-size: 18px;
  }

  .brand-small .brand-mark {
    width: 30px;
    height: 30px;
  }

  .brand-small .brand-mark::before,
  .brand-small .brand-mark::after {
    top: 6px;
    width: 18px;
    height: 18px;
  }

  .brand-small .brand-mark::before {
    left: 2px;
  }

  .brand-small .brand-mark::after {
    left: 9px;
  }

  .config-rail-title {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0 4px;
  }

  .config-rail-title h2 {
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.12;
  }

  .rail-steps {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rail-step {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 10px 12px;
    border: 0;
    border-radius: 16px;
    background: transparent;
    color: var(--ink-2);
    text-align: left;
    transition: background-color 0.15s;
  }

  .rail-step:disabled {
    cursor: default;
  }

  .rail-step:hover:not(:disabled, .is-active) {
    background: rgb(255 255 255 / 60%);
  }

  .rail-step-dot {
    display: grid;
    flex: none;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 2px solid var(--pending);
    border-radius: 50%;
    color: var(--ink-3);
    font-size: 14px;
    font-weight: 800;
  }

  .rail-step-check {
    display: none;
  }

  .rail-step-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .rail-step-text strong {
    font-size: 15px;
    font-weight: 800;
  }

  .rail-step-text span {
    color: var(--ink-3);
    font-size: 13px;
    font-weight: 600;
  }

  .rail-step.is-active {
    background: var(--surface);
    box-shadow: 0 1px 3px rgb(29 35 64 / 10%);
    color: var(--ink);
  }

  .rail-step.is-active .rail-step-dot {
    border-color: var(--ink);
    background: var(--surface);
    color: var(--ink);
  }

  .rail-step.is-done {
    color: var(--ink);
  }

  .rail-step.is-done .rail-step-dot {
    border-color: var(--ink);
    background: var(--ink);
    color: #ffffff;
  }

  .rail-step.is-done .rail-step-number {
    display: none;
  }

  .rail-step.is-done .rail-step-check {
    display: block;
  }

  .rail-privacy {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-top: auto;
    padding: 14px;
    border-radius: 16px;
    background: var(--surface);
    color: var(--ink-2);
    font-size: 13px;
    line-height: 1.5;
  }

  .config-main {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
  }

  .config-header {
    display: grid;
    grid-template-areas:
      'heading close'
      'progress close';
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px 20px;
    padding: 24px 24px 18px 40px;
  }

  .config-header .sheet-handle,
  .config-mobile-title,
  .config-reset-mobile {
    display: none;
  }

  .config-heading {
    grid-area: heading;
  }

  #config-step-label {
    color: var(--ink-3);
    font-size: 14px;
    font-weight: 800;
  }

  .config-progress {
    display: grid;
    grid-area: progress;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    gap: 6px;
  }

  .config-progress span {
    height: 6px;
    border-radius: 999px;
    background: var(--line);
    transition: background-color 0.2s;
  }

  .config-progress span.is-filled {
    background: var(--ink);
  }

  .config-close {
    grid-area: close;
    border-color: var(--line);
  }

  .config-body {
    flex: 1;
    min-height: 0;
    padding: 10px 40px 32px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .config-error {
    margin: 0 40px 12px;
    padding: 12px 16px;
    border-radius: 14px;
    background: var(--danger-soft);
    color: var(--danger);
    font-size: 14px;
    font-weight: 700;
  }

  .config-footer {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 24px 16px 32px;
    border-top: 1px solid var(--line);
    background: var(--surface-muted);
  }

  .config-footer-spacer {
    flex: 1;
  }

  .config-step {
    display: flex;
    flex-direction: column;
    gap: 24px;
    animation: step-in 0.25s ease-out;
  }

  .step-heading {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .step-heading h3 {
    font-size: clamp(24px, 3vw, 30px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .step-heading p {
    max-width: 580px;
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.6;
  }

  /* Vacaciones y festivos */
  .school-dialog {
    width: min(880px, calc(100% - 48px));
    height: min(820px, calc(100dvh - 48px));
    margin: auto;
  }

  .school-shell {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: 28px;
    background: var(--surface);
    box-shadow: var(--shadow-dialog);
  }

  .school-header {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 28px 24px 22px 32px;
    border-bottom: 1px solid var(--line);
  }

  .school-header-icon {
    width: 48px;
    height: 48px;
    border-radius: 16px;
  }

  .school-heading {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .school-heading h2 {
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .school-heading p:last-child {
    max-width: 600px;
    margin-top: 4px;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.55;
  }

  .school-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 20px;
    min-height: 0;
    padding: 24px 32px 32px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .school-body > * {
    flex: none;
  }

  .school-dialog .config-error {
    margin: 0 32px 12px;
  }

  .school-footer-note {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink-3);
    font-size: 13px;
    font-weight: 600;
  }

  /* Campos */
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .field-label {
    padding: 0;
    color: var(--ink-2);
    font-size: 14px;
    font-weight: 700;
  }

  .field-hint {
    color: var(--ink-3);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.5;
  }

  .field-compact {
    gap: 6px;
  }

  .field-compact .field-label {
    font-size: 13px;
  }

  .input {
    width: 100%;
    height: 50px;
    padding: 0 16px;
    border: 1.5px solid var(--line-strong);
    border-radius: 14px;
    background: var(--surface);
    color: var(--ink);
    font-size: 16px;
    font-weight: 700;
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }

  .input:focus {
    border-color: var(--ink);
    outline: none;
    box-shadow: 0 0 0 3px rgb(29 35 64 / 12%);
  }

  .input:user-invalid {
    border-color: var(--danger);
  }

  .select-wrap,
  .input-icon {
    position: relative;
    display: block;
  }

  .select-wrap select {
    padding-right: 44px;
    appearance: none;
    cursor: pointer;
  }

  .select-wrap .icon,
  .input-icon .icon {
    position: absolute;
    top: 50%;
    color: var(--ink-2);
    pointer-events: none;
    translate: 0 -50%;
  }

  .select-wrap .icon {
    right: 14px;
  }

  .input-icon .icon {
    left: 16px;
  }

  .input-icon .input {
    padding-left: 44px;
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    align-items: start;
    gap: 18px;
  }

  .form-row-end {
    align-items: end;
  }

  /* Personas */
  .person-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 16px;
  }

  .person-card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
    margin: 0;
    padding: 20px;
    border: 1.5px solid var(--line);
    border-radius: 22px;
  }

  .person-card-header {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .person-card-header > span:last-child {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .person-card-header .overline {
    font-size: 12px;
  }

  .person-card-header strong {
    font-size: 18px;
    font-weight: 800;
  }

  .swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 3px;
  }

  .swatch-option {
    position: relative;
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--swatch);
    box-shadow: inset 0 0 0 1px rgb(29 35 64 / 8%);
    color: var(--ink-2);
    cursor: pointer;
  }

  .swatch-option[aria-pressed='true'],
  .swatch-custom.is-selected {
    box-shadow:
      0 0 0 3px var(--surface),
      0 0 0 5px var(--ink);
  }

  .swatch-custom {
    border: 1.5px dashed var(--dashed);
    background: var(--swatch, var(--surface));
  }

  .swatch-custom.is-selected {
    border-color: transparent;
  }

  .swatch-custom.is-selected .icon {
    display: none;
  }

  .swatch-custom input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    opacity: 0;
    cursor: pointer;
  }

  .swatch-custom:focus-within {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .preview-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--surface-soft);
  }

  .preview-title {
    font-size: 14px;
    font-weight: 800;
  }

  .preview-weeks {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .preview-week {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
  }

  .preview-week span {
    display: grid;
    place-items: center;
    height: 34px;
    background: var(--person);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .preview-week span:first-child {
    border-radius: 10px 0 0 10px;
  }

  .preview-week span:last-child {
    border-radius: 0 10px 10px 0;
  }

  /* Selectores */
  .segmented {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px;
    padding: 4px;
    border-radius: 16px;
    background: var(--muted);
  }

  .segmented label,
  .weekday-picker label {
    position: relative;
  }

  .segmented input,
  .weekday-picker input,
  .choice-card input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .segmented label > span {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 42px;
    padding: 0 8px;
    overflow: hidden;
    border-radius: 12px;
    color: var(--ink-2);
    font-size: 15px;
    font-weight: 700;
    white-space: nowrap;
  }

  .segmented .person-dot {
    width: 12px;
    height: 12px;
  }

  .segmented input:checked + span {
    background: var(--surface);
    box-shadow: 0 1px 3px rgb(29 35 64 / 12%);
    color: var(--ink);
    font-weight: 800;
  }

  .segmented input:focus-visible + span,
  .weekday-picker input:focus-visible + span,
  .choice-card:has(input:focus-visible),
  .toggle-card:has(input:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .weekday-picker {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 6px;
    max-width: 420px;
  }

  .weekday-picker span {
    display: grid;
    place-items: center;
    height: 44px;
    border: 1.5px solid var(--line-strong);
    border-radius: 12px;
    background: var(--surface);
    font-size: 15px;
    font-weight: 700;
  }

  .weekday-picker input:checked + span {
    border-color: var(--ink);
    background: var(--ink);
    color: #ffffff;
    font-weight: 800;
  }

  .stepper {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 50px;
    padding: 3px;
    border: 1.5px solid var(--line-strong);
    border-radius: 14px;
    background: var(--surface);
  }

  .stepper button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: 11px;
    background: var(--muted);
    color: var(--ink);
  }

  .stepper-value {
    display: flex;
    flex: 1;
    align-items: baseline;
    justify-content: center;
    gap: 6px;
    font-size: 16px;
    font-weight: 800;
  }

  .stepper input {
    width: 2.5ch;
    padding: 0;
    border: 0;
    background: transparent;
    font-weight: 800;
    text-align: right;
    appearance: textfield;
  }

  .stepper input::-webkit-inner-spin-button,
  .stepper input::-webkit-outer-spin-button,
  .year-input input::-webkit-inner-spin-button,
  .year-input input::-webkit-outer-spin-button,
  .chip-add input::-webkit-inner-spin-button,
  .chip-add input::-webkit-outer-spin-button {
    margin: 0;
    appearance: none;
  }

  .choice-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 10px;
  }

  .choice-card {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px;
    border: 2px solid var(--line);
    border-radius: 18px;
    background: var(--surface);
    cursor: pointer;
    transition:
      border-color 0.15s,
      background-color 0.15s;
  }

  .choice-card:has(input:checked) {
    border-color: var(--ink);
    background: var(--surface-soft);
  }

  .choice-radio {
    display: grid;
    flex: none;
    place-items: center;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    border: 2px solid var(--dashed);
    border-radius: 50%;
  }

  .choice-radio::after {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--ink);
    transform: scale(0);
    transition: transform 0.15s;
  }

  .choice-card input:checked ~ .choice-radio {
    border-color: var(--ink);
  }

  .choice-card input:checked ~ .choice-radio::after {
    transform: scale(1);
  }

  .choice-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .choice-text strong {
    font-size: 16px;
    font-weight: 800;
  }

  .choice-text span {
    color: var(--ink-2);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.45;
  }

  /* Interruptores */
  .toggle-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 16px 16px 18px;
    border: 1px solid var(--warm-line);
    border-radius: 20px;
    background: var(--warm-soft);
    cursor: pointer;
  }

  .toggle-card input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    opacity: 0;
  }

  .toggle-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--surface);
    color: var(--sun-icon);
  }

  .toggle-text {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .toggle-text strong {
    font-size: 16px;
    font-weight: 800;
  }

  .toggle-text span {
    color: var(--warm-ink);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.45;
  }

  .switch {
    position: relative;
    flex: none;
    width: 52px;
    height: 32px;
    border-radius: 999px;
    background: var(--pending);
    transition: background-color 0.2s;
  }

  .switch::after {
    content: '';
    position: absolute;
    top: 4px;
    left: 4px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 25%);
    transition: transform 0.2s;
  }

  .toggle-card input:checked ~ .switch {
    background: var(--ink);
  }

  .toggle-card input:checked ~ .switch::after {
    transform: translateX(20px);
  }

  .toggle-card-compact {
    gap: 12px;
    padding: 8px 8px 8px 16px;
    border-radius: 16px;
  }

  .toggle-card-compact .toggle-text strong {
    font-size: 15px;
  }

  .toggle-card-compact .toggle-text span {
    font-size: 13px;
  }

  /* Verano */
  .summer-fields {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
    transition: opacity 0.2s;
  }

  .summer-fields:disabled {
    opacity: 0.45;
  }

  .chip-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .chips {
    display: contents;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    background: var(--tint);
    font-size: 15px;
    font-weight: 800;
  }

  .chip:has(button) {
    padding-right: 4px;
  }

  .chip button {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink-2);
  }

  .chip button:hover {
    background: rgb(29 35 64 / 8%);
  }

  .chip-add {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 44px;
    padding: 0 4px 0 5px;
    border: 1.5px dashed var(--dashed);
    border-radius: 999px;
  }

  .chip-add input {
    width: 64px;
    height: 34px;
    border: 0;
    border-radius: 999px;
    background: var(--muted);
    font-weight: 700;
    text-align: center;
    appearance: textfield;
  }

  .chip-add button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 12px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-2);
    font-size: 15px;
    font-weight: 800;
  }

  .chip-add button:hover {
    background: var(--muted);
    color: var(--ink);
  }

  .summer-preview {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .summer-segment {
    display: flex;
    flex: 1 1 88px;
    flex-direction: column;
    gap: 2px;
    padding: 10px 10px 12px;
    border-radius: 4px;
    background: var(--person);
    box-shadow: inset 0 -3px 0 var(--sun);
    font-size: 13px;
    font-weight: 600;
  }

  .summer-segment strong {
    font-weight: 800;
  }

  .summer-segment:first-child {
    border-radius: 12px 4px 4px 12px;
  }

  .summer-segment:last-child {
    border-radius: 4px 12px 12px 4px;
  }

  .summer-segment:only-child {
    border-radius: 12px;
  }

  /* Calendario escolar */
  .rule-panel {
    overflow: hidden;
    border: 1.5px solid var(--line);
    border-radius: 24px;
  }

  .rule-panel-header {
    display: flex;
    flex-wrap: wrap;
